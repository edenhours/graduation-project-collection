{
  "id": "a01",
  "year": "2026",
  "title": "猫与栖居 · 情感化猫形态家具的疗愈价值探",
  "authors": "陈秀蕾",
  "teachers": "王时音",
  "type": "情感化家具 · 疗愈设计",
  "typeCat": "家具/家居",
  "motif": "记忆/身份/情感",
  "highlight": "把猫的八种姿态译成了八件家具，并用「24 小时」而不是「功能」来分配它们的角色——家具第一次被当成一张时间轴上的陪伴排班表。",
  "concept": "为「想养猫而不能养」的独居青年，把猫的陪伴做成一组可以坐、可以靠、可以被环抱的非生命伴侣。",
  "culture": ["独居青年文化", "陪伴经济与治愈系审美", "猫的行为学（姿态即情绪）"],
  "cultureNote": "抓住的是当代城市青年的「结构性缺陪伴」——租房不能养宠、工作时长挤压社交。猫在此不是动物，而是被抽象成一组「陪伴姿态」：蜷、卧、伸、靠。作者把生物行为学转译为家具的功能语义。",
  "symbols": [
      {
          "src": "猫的八种行为姿态（蜷缩、伸展、伏卧…）",
          "way": "抽象几何体块概括，明确摒弃具象符号拼贴",
          "out": "八件单品构成的「猫椅家族」"
      },
      {
          "src": "猫的触感（毛、体温、柔软）",
          "way": "材质选择与低饱和度暖色系",
          "out": "温柔触感与治愈氛围"
      },
      {
          "src": "独居者的 24 小时生活时刻",
          "way": "一件家具对应一个时刻",
          "out": "时间维度上的陪伴角色分配"
      },
      {
          "src": "「触即治愈」这一理念",
          "way": "轻量文创化（书立、笔筒）",
          "out": "理念从家具延伸到桌面日常"
      }
  ],
  "transMethod": ["产品语义", "功能嫁接", "形态转译", "情绪转译", "材料转译"],
  "presentation": ["家具实物", "场景渲染图", "文创衍生品", "姿态对照"],
  "presCat": "实物/产品",
  "presNote": "以「家族」方式呈现——八件单品并置，强调群体关系而非单件造型；场景图把家具放回独居者的真实生活时段，让功能叙事成立。",
  "narration": "人群 — 意象 — 系统",
  "narrMethod": "人群—意象—体验",
  "narrBreak": {
      "opening": "先锁定人群（「想养猫而不能养」），一句即完成用户画像，比任何数据都更有画面感。",
      "structure": "人群定义 → 意象注入（治愈特质与陪伴意象）→ 系统构建（八件 / 24 小时 / 不同时刻）→ 手法说明（抽象几何、低饱和、故事化）→ 文创延伸 → 意义升华（非生命伴侣）。",
      "rhetoric": "反复用排除法界定边界（「摒弃具象符号拼贴」）；用「非生命伴侣」「触即治愈」这类自造词制造记忆点。",
      "closing": "以「回应其对安全、陪伴与审美的多重需求」收尾，把情感需求显式化、正当化。"
  },
  "narrNote": "情感驱动型表达：叙述主语是「人」（独居者）而非「物」（椅子），器物只是回应需求的载体。这是五件中最会讲情绪的一件。",
  "desc": "“猫与栖居”是为城市独居青年设计的一组情感化猫形态艺术家具系列。作品以“想养猫而不能养”的群体为对象，将猫的治愈特质与陪伴意象融入家具设计，构建由八件单品组成的“猫椅家族”。每件家具对应猫的不同行为姿态，承担独居者24小时生活中不同时刻的情感陪伴角色。设计采用抽象几何体块概括猫的形态特征，摒弃具象符号拼贴，以材质、低饱和度暖色系以及故事情节设计来营造温柔触感与治愈氛围。文创系列同步开发书立、笔筒等产品，以轻量化形式延伸“触即治愈”的理念。“猫与栖居”让家具成为独居青年日常生活中的非生命伴侣，回应其对安全、陪伴与审美的多重需求。",
  "kw": ["猫", "独居青年", "情感化设计", "疗愈", "家具", "陪伴", "低饱和", "文创", "猫椅家族"],
  "imgs": ["a01_00.jpg", "a01_01.jpg", "a01_02.jpg", "a01_03.jpg"]
