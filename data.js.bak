{
  "id": "a02",
  "year": "2026",
  "title": "南绪 —— 岭南女性叙事文创首饰设计",
  "authors": "李润仪",
  "teachers": "胡好",
  "type": "文创首饰 · 文化叙事设计",
  "typeCat": "首饰/可穿戴",
  "motif": "女性与身体叙事",
  "highlight": "拒绝把桑基鱼塘当纹样库，而是把它的「循环结构」整个搬来做叙事骨架：桑=扎根、蚕蛾=蜕变、池=反哺，三件首饰刚好是一部三幕剧。",
  "concept": "用桑基鱼塘的「生态循环」作比喻，把岭南女性的生命历程写成可佩戴的三幕剧：扎根 — 蜕变 — 反哺。",
  "culture": ["岭南桑基鱼塘共生系统", "岭南女性劳动史与身份变迁", "她经济与女性主义叙事", "科幻数字美学"],
  "cultureNote": "桑基鱼塘是「基上种桑、桑叶喂蚕、蚕粪喂鱼、塘泥肥桑」的闭环农业系统。作者的关键动作是拒绝把它当纹样库，而是当「结构」——一个关于循环、劳动与反哺的社会生态模型，再用它映射女性身份。这是从「符号挪用」到「结构转译」的跃迁。",
  "symbols": [
      {
          "src": "桑（扎根 / 供养）",
          "way": "参数化模块、线性生长结构",
          "out": "《沉潜之桑》系列"
      },
      {
          "src": "蚕与蛾（蜕变 / 破茧）",
          "way": "可拆卸、可开合的互动结构",
          "out": "《破茧之蛾》系列"
      },
      {
          "src": "池（涵育 / 反哺）",
          "way": "包容性曲面与嵌套结构",
          "out": "《涵育之池》系列"
      },
      {
          "src": "循环系统本身",
          "way": "模块化、可互动的佩戴方式",
          "out": "佩戴者亲手完成一次叙事"
      },
      {
          "src": "数字共生体",
          "way": "实体首饰 + 虚拟形象双路线",
          "out": "文化、身体与技术的共生"
      }
  ],
  "transMethod": ["形态转译", "概念转译", "行为绑定", "行为转译", "造型挪用"],
  "presentation": ["首饰佩戴图", "参数化结构图", "虚拟共生体渲染", "展板排版"],
  "presCat": "渲染/模型",
  "presNote": "三系列分章呈现，每件既是首饰也是叙事的一幕；「实体 + 虚拟」双线让静态首饰获得延展的时间维度。",
  "narration": "破题 — 重构 — 分章",
  "narrMethod": "批判—重构—质询",
  "narrBreak": {
      "opening": "先立靶子——「突破传统文化文创符号化挪用困境」，用一句学术化批判声明立场与高度。",
      "structure": "内核界定（共生体系）→ 视角聚焦（女性身份与劳动价值）→ 转译手法（科幻数字美学）→ 元素提取（桑 / 蚕 / 池）→ 三大系列 → 形态策略（模块化、参数化）→ 生命叙事（扎根—蜕变—反哺）→ 双路线 → 理念。",
      "rhetoric": "密集使用四字词与学术术语（符号化挪用、双重循环、参数化、身份重构）建立专业密度；用「被塑造，亦塑造」的回文句式收束核心理念，极易记忆。",
      "closing": "落到「她经济」与「文化创新」，把文化议题接进当代消费语境。"
  },
  "narrNote": "论文型表达：先做学术定位（反对什么），再给方法论（用什么转译），最后用三幕结构把抽象叙事落成三件可命名的作品。概念与物件一一对应，是五件中逻辑最严密的一件。",
  "desc": "本作品以岭南桑基鱼塘共生文化系统为内核，突破传统文化文创符号化挪用困境，将其界定为生态与社会文化双重循环的共生体系，聚焦岭南女性身份变迁与劳动价值。以科幻数字美学为转译手法，提取桑、蚕、池核心生态元素，打造《沉潜之桑》《破茧之蛾》《涵育之池》三大系列，采用模块化、可拆卸、可互动的参数化设计，构建“扎根-蜕变-反哺”的女性生命叙事。作品打造“实体首饰+虚拟共生体”双路线形态，将生态循环、女性身体实践与身份重构逻辑融入佩戴设计，实现岭南文化、女性精神与数字技术共生融合，传递“被塑造，亦塑造”的理念，激活传统文化当代表达，赋能女性身份叙事与“她经济”文化创新。",
  "kw": ["桑基鱼塘", "岭南", "女性叙事", "首饰", "参数化", "模块化", "非遗活化", "她经济", "虚拟共生体", "破茧"],
  "imgs": ["a02_00.jpg", "a02_01.jpg", "a02_02.jpg", "a02_03.jpg", "a02_04.jpg", "a02_05.jpg"]
  },
{
  "id": "a03",
  "year": "2026",
  "title": "海丝花语 —— 跨文化花卉潮玩设计",
  "authors": "卢锐淇、陆曼怡",
  "teachers": "丁敏",
  "type": "潮玩 IP · 跨文化文创",
  "typeCat": "潮玩/IP/角色",
  "motif": "当代媒介与流行文化",
  "highlight": "抓住「同源异流」——同一株花在东西方长出两种命运，于是做成两两成对的「双生花灵」，让植物迁徙史变成可以收藏的 CP。",
  "concept": "把海上丝绸之路上远行又扎根的四组花，拟人成八位「双生花灵」，用潮玩承接一段跨文化的植物迁徙史。",
  "culture": ["海上丝绸之路", "中外植物交流史", "花语象征系统", "潮玩与角色经济"],
  "cultureNote": "素馨、水仙、山茶、月季都是经海路进入西方园艺体系、又反向影响中国近代观赏文化的物种。作者抓住的核心张力是「同源异流」——同一株花在两地长出不同的文化意义。潮玩在此是史料的容器：让植物学史变成可收藏的角色。",
  "symbols": [
      {
          "src": "素馨、水仙、山茶、月季",
