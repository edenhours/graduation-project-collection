  "transMethod": ["行为绑定", "产品语义", "品牌叙事"],
  "presentation": ["共创过程记录", "衍生品实物", "展板排版", "校园场景"],
  "presCat": "平面/视觉/图像",
  "presNote": "呈现重心不是单件产品，而是「过程 + 结果」的双层结构：先展示人如何参与（共创现场、画作征集），再展示物如何落地（衍生品），最后以收益去向闭合。展陈顺序本身就是闭环的视觉化。",
  "narration": "议题 — 机制 — 闭环",
  "narrMethod": "问题—机制—价值",
  "narrBreak": {
      "opening": "以「现象」开篇——校园流浪猫现象，不谈审美，先谈共处，把设计问题社会化。",
      "structure": "现象 → 行动（画猫共创）→ 收集（情感记忆与视觉表达）→ 转化（衍生品）→ 反馈（收益救助）→ 意义（公共议题、和谐共处、可复制路径）。",
      "rhetoric": "高频使用破折号连接的三段式闭环句（「情感表达—设计转化—公益反馈」），用可背诵的结构替代形容词堆砌；结尾连用「新模式」「新路径」抬高价值层级。",
      "closing": "落在「探索…模式」与「提供…路径」，把一件学生作业说成可复制的方法论。"
  },
  "narrNote": "典型的方法论型表达：作者几乎不描述造型与色彩，通篇讲机制与关系。说服力来自闭环的完整性，而不是物件本身。",
  "desc": "本设计以广州美术学院校园流浪猫现象为切入点，邀请师生共同参与“画猫共创”活动，绘制心中的校园猫形象，收集关于校园流浪猫的情感记忆与视觉表达。项目将共创成果转化为校园文化衍生品，并将部分收益用于流浪猫救助，形成“情感表达—设计转化—公益反馈”的共创闭环。设计希望通过参与式设计的方式，增强师生对校园公共议题的关注与互动，探索人与流浪猫和谐共处的校园文化新模式，同时为校园公益与文化传播提供新的设计实践路径。",
  "kw": ["流浪猫", "共创", "参与式设计", "校园公益", "衍生品", "广州美术学院", "画猫", "闭环"],
