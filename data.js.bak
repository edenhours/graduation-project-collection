  "type": "潮玩 IP · 艺术衍生品",
  "typeCat": "潮玩/IP/角色",
  "motif": "当代媒介与流行文化",
  "highlight": "把『艺术家』与『玩具』两个本不搭界的身份焊在一起——OMINC 让艺术家形象变成可被把玩的潮玩，消解了艺术的严肃距离。",
  "concept": "以艺术家角色为母题开发潮玩，把创作者的身份、姿态与工作现场浓缩成可收藏、可把玩的实体，让艺术人格从画布后走到手心。",
  "culture": ["艺术家人格化与IP化", "潮流玩具与角色经济", "当代艺术的去神圣化"],
  "cultureNote": "OMINC 把『艺术家』这一神圣职业做成玩具，本质是对艺术权威的温和消解——当艺术家能被把玩，艺术与大众的门槛就被拆掉一层。它踩中了潮玩时代的角色消费逻辑。",
  "symbols": [
      {
          "src": "艺术家形象/姿态",
          "way": "夸张化、角色化塑形",
          "out": "可收藏的艺术家潮玩"
      },
      {
          "src": "创作现场元素（调色、笔触）",
          "way": "符号化嵌入造型",
          "out": "关于『如何创作』的叙事"
      },
      {
          "src": "艺术家与观众的距离",
          "way": "把距离压缩成掌中尺寸",
          "out": "艺术的去神圣化"
      }
  ],
  "transMethod": ["品牌叙事", "形态转译", "概念转译", "色彩转译", "行为绑定"],
  "presentation": ["潮玩实物", "角色设定", "包装陈列", "展板"],
  "presCat": "实物/产品",
  "presNote": "典型潮玩化呈现：白底产品图确立收藏属性，角色设定补足人格，并置陈列强化系列感。",
  "narration": "母题 — 角色 — 消费",
  "narrMethod": "媒介—角色—传播",
  "narrBreak": {
      "opening": "以『艺术家』这一高冷身份作母题，天然制造反差。",
      "structure": "身份抽取 → 角色化塑形 → 系列化呈现 → 消费语境落地。",
      "rhetoric": "用反差与可爱化解严肃，制造记忆点。",
      "closing": "落到『艺术走进日常把玩』。"
  },
  "narrNote": "IP先行型表达：以角色而非理论驱动，适合潮玩传播，信息量偏薄但传播力强。",
  "desc": "《OMINC艺术家玩具》以艺术家角色为母题开发潮流玩具，把创作者的身份、姿态与工作现场浓缩为可收藏、可把玩的实体。作品将艺术人格从画布之后请到掌心，以夸张化、角色化的塑形消解艺术的严肃距离，踩中潮玩时代的角色消费逻辑，让艺术以更轻松的方式进入大众生活。",
  "kw": ["OMINC", "艺术家玩具", "潮玩", "角色经济", "艺术衍生品", "去神圣化", "张学禹", "韩臻元"],
  "imgs": ["a49_00.jpg", "a49_01.jpg", "a49_02.jpg"]
