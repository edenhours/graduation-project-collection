{
  "id": "a14",
  "year": "2025",
  "title": "宇宙传讯",
  "sub": "融合占卜文化的茶饮体验设计",
  "authors": "钟雅意",
  "teachers": "王柳庄、李健、彭圣芳",
  "topic": "Hello！中国茶 — 茶文化研究与创新设计",
  "type": "体验设计 · 情感化产品",
  "typeCat": "产品设计",
  "motif": "饮食文化",
  "highlight": "看出占卜的本质不是预测未来而是情绪安抚，于是干脆把它做成茶饮的互动机制——一杯茶的时间完成一次低成本的心理按摩。",
  "concept": "用「星骰」把占卜的心理暗示机制装进一杯茶里，让喝茶变成一次与自己对话的仪式。",
  "culture": ["占卜文化", "星骰（占星骰子）", "心理暗示与情感安抚", "茶饮仪式"],
  "cultureNote": "占卜在当代年轻人里的复兴（星座、塔罗、求签）本质上是一种情绪自助工具。作者把这个洞察说得很直白——「占卜文化蕴含丰富的心理暗示与情感安抚的作用」，这是全作最锋利的一句，也是整个方案的合法性来源。",
  "symbols": [
      {
          "src": "占卜的心理暗示机制",
          "way": "「星骰」互动",
          "out": "行为层设计"
      },
      {
          "src": "星象与骰子",
          "way": "视觉与器物",
          "out": "符号层设计"
      },
      {
          "src": "茶饮的等待时间",
          "way": "仪式感填充",
          "out": "体验层设计"
      }
  ],
  "transMethod": ["情绪转译", "行为绑定", "行为转译"],
  "presentation": ["产品实物", "星骰组件", "视觉系统", "展板排版"],
  "presCat": "实物/产品",
  "presNote": "以「星骰 + 茶饮」的组合装置呈现，视觉上强调神秘感与现代感的平衡（不做成老气玄学）。",
  "narration": "洞察 — 机制 — 价值",
  "narrMethod": "问题—机制—价值",
  "narrBreak": {
      "opening": "第一句就是洞察（占卜的心理暗示与情感安抚作用），不是背景介绍而是论点。",
      "structure": "洞察 → 结合方式（占卜 × 茶饮）→ 机制（星骰）→ 手段（行为、产品、视觉设计）→ 双重价值（文化价值 + 情感价值）→ 意义。",
      "rhetoric": "「兼具文化价值与情感价值」是价值声明的标准句式；「构建」一词表明作者清楚自己在做什么层级的创新。",
      "closing": "落在「为传统茶饮构建新的文化内容和意义」，把一次商业创新说成文化生产。"
  },
  "narrNote": "洞察驱动型：先有一个关于人性的判断，再倒推产品。这类自述的可信度取决于洞察是否锋利——本作的洞察确实够狠。",
  "desc": "占卜文化蕴含丰富的心理暗示与情感安抚的作用，本方案通过把占卜与茶饮结合，以“星骰”互动机制，通过行为、产品与视觉设计，为消费者提供一种兼具文化价值与情感价值的茶饮体验，从而为传统茶饮构建新的文化内容和意义。",
  "kw": ["占卜", "星骰", "茶饮", "情感安抚", "心理暗示", "体验设计", "仪式感"],
  "imgs": ["a14_00.jpg"]
  },
{
  "id": "a15",
  "year": "2025",
  "title": "尘封之祠",
  "sub": "实境解谜游戏",
  "authors": "刘欣彤",
  "teachers": "卢文英、磨炼",
  "topic": "游戏之外 — 游戏化在博物馆公共教育中的应用",
  "type": "实景游戏 · 博物馆教育",
  "typeCat": "游戏/桌游",
  "motif": "当代媒介与流行文化",
  "highlight": "给陈家祠这个最正统的宗祠空间，硬塞进一层神怪幻想——祠堂里原本供奉的祖先叙事被改写成可探索的剧本，敬畏感反而因此变得可亲近。",
  "concept": "在陈家祠里叠加一层神怪幻想的叙事，让宗祠文化变成一场可以亲自走进去的解谜。",
  "culture": ["岭南宗祠文化", "陈家祠（广东宗祠建筑集大成）", "岭南神怪传说与民间信仰", "博物馆公共教育"],
  "cultureNote": "宗祠是最难做青少年传播的文化空间——涉及祖先、礼制、宗族，对年轻人天然有距离感。作者的解法是「叠加」而非「替换」：历史建筑本身不动，在其上叠加一层幻想叙事，用神怪传说接住年轻人的兴趣，再把真实的建筑知识放进解谜。",
  "symbols": [
      {
          "src": "陈家祠的建筑与装饰（木雕、砖雕、灰塑）",
          "way": "解谜线索与关卡",
          "out": "游戏化知识输出"
      },
      {
          "src": "岭南神怪幻想元素",
          "way": "剧情外壳",
          "out": "吸引力来源"
      },
      {
          "src": "祖先与宗族叙事",
          "way": "角色与任务",
          "out": "情感连接"
      }
  ],
  "transMethod": ["品牌叙事", "色彩转译", "角色化"],
  "presentation": ["游戏界面", "实景点位地图", "剧情插画", "展板排版"],
  "presCat": "影像/交互/动态",
  "presNote": "以「手机界面 + 实景点位」双线呈现，证明游戏真的能在这个空间里跑起来。",
  "narration": "对象 — 融合 — 方法 — 目标",
  "narrMethod": "人群—意象—体验",
  "narrBreak": {
      "opening": "直接给出研究对象（广州陈家祠）与文化内核（岭南传统宗祠文化）。",
      "structure": "对象 → 融合（宗祠文化 × 神怪幻想）→ 方法（实地探索 + 剧情驱动）→ 内容（历史、传说、文化 × 游戏机制）→ 学术目标（探讨…可能性）→ 手段 → 传播目标。",
      "rhetoric": "「巧妙融合」「搭建桥梁」这类连接词密集出现，反映出作者的核心能力是「把 A 和 B 接起来」。",
      "closing": "落在「推广至更广阔的受众群体」，明确了博物馆教育的评估指标。"
  },
  "narrNote": "教育技术研究型表达：出现了「探讨…的可能性」这种典型论文口吻，学术自觉很强。",
  "desc": "作品以广州陈家祠为例，融合岭南传统宗祠文化与神怪幻想元素，通过“实地探索+剧情驱动”的方式，将历史、传说、文化与现代游戏机制巧妙融合。探讨叙事视角下宗祠文化游戏化学习与教育传播的可能性，通过实景游戏的方式搭建宗祠文化古代与现代教育与传播之间的桥梁，将陈家祠所代表的岭南宗祠文化推广至更广阔的受众群体。",
  "kw": ["陈家祠", "宗祠文化", "神怪", "实景游戏", "解谜", "博物馆教育", "岭南", "青少年"],
  "imgs": ["a15_00.jpg"]
  },
{
  "id": "a16",
  "year": "2025",
  "title": "回信沙面",
  "sub": "实景探索游戏",
  "authors": "张秀泽",
  "teachers": "卢文英、磨炼",
  "topic": "游戏之外 — 游戏化在博物馆公共教育中的应用",
  "type": "实景游戏 · 城市记忆叙事",
  "typeCat": "游戏/桌游",
  "motif": "当代媒介与流行文化",
  "highlight": "用「两个人共同读一本旧笔记」这个动作串起整部游戏——历史不是被讲解的，是被两个人一点点拼出来的，城市记忆由此有了对话的温度。",
  "concept": "让一位归乡华侨与一位沙面后人一起解读一本旧笔记，在实景里重构沙面的百年。",
  "culture": ["沙面岛的殖民遗产与近代史", "华侨与归乡叙事", "民间史与个体记忆", "广州城市记忆"],
  "cultureNote": "沙面是广州最复杂的城市空间之一：英法租界、十三行旧址旁、现在是市民公园。作者避开了「租界建筑很美」的表层叙事，选择「民间视角下的殖民遗产、时代变迁与个体奋斗」——把宏大近代史拆成信件、笔记、记忆碎片。",
  "symbols": [
      {
          "src": "沙面的建筑与街道",
          "way": "实景探索点位",
          "out": "空间即档案"
      },
      {
          "src": "旧笔记、信件、记忆碎片",
          "way": "解谜线索",
          "out": "叙事载体"
      },
      {
          "src": "归乡华侨 × 沙面后人",
          "way": "双主角设定",
          "out": "历史的多声部"
      },
      {
          "src": "时间的层积",
          "way": "追溯与重构",
          "out": "游戏主线"
      }
  ],
  "transMethod": ["概念转译"],
  "presentation": ["游戏界面", "地图与线索", "叙事插画", "展板排版"],
  "presCat": "影像/交互/动态",
  "presNote": "以双主角加线索系统呈现，强调「共同解读」这一互动结构，而非单纯的解谜难度。",
  "narration": "形式 — 情节 — 视角 — 共鸣",
  "narrMethod": "媒介—角色—传播",
  "narrBreak": {
      "opening": "先定形式（实景探索游戏），再给出具体情节（华侨与后人共读旧笔记），画面感极强。",
      "structure": "形式 → 情节设定 → 行动（追溯与重构）→ 媒介（信件、笔记、记忆碎片）→ 视角（民间视角）→ 主题 → 共鸣。",
      "rhetoric": "「祖辈间的信件、笔记与记忆碎片」三个名词并列，构成温柔的质感；「民间视角」是全篇的立场锚点。",
      "closing": "「唤起观众对城市记忆与历史温度的共鸣」——「温度」二字点题。"
  },
  "narrNote": "叙事驱动型：几乎不谈玩法机制，全篇在讲「这是谁的故事」。在游戏类毕设里，这是最有文学性的一篇。",
  "desc": "《回信沙面》是以实景探索游戏为基础，围绕一位归乡华侨与一位沙面后人共同解读一本旧笔记的过程，展开对沙面百年历史的追溯与重构。通过祖辈间的信件、笔记与记忆碎片，展现民间视角下的殖民遗产、时代变迁与个体奋斗，唤起观众对城市记忆与历史温度的共鸣。",
  "kw": ["沙面", "实景游戏", "华侨", "城市记忆", "殖民遗产", "民间视角", "广州", "笔记"],
  "imgs": ["a16_00.jpg"]
  },
{
  "id": "a17",
  "year": "2025",
  "title": "VITA：蚀纪元",
  "sub": "生态思辨设计",
  "authors": "郭嘉诺、邢佳怡",
  "teachers": "胡好、庄嘉菁",
  "topic": "叙事性首饰与装置创新设计",
  "type": "思辨设计 · 叙事首饰",
  "typeCat": "首饰/可穿戴",
  "motif": "自然生态与地方景观",
  "highlight": "把造物反噬人类的老命题压进一个具体设定：VITA 不只是造反，而是「吞噬并重组万物基因」——进化裁判权的转移，被做成了可以佩戴的末世标本。",
  "concept": "设定 1500 年后的末世，让人类造出的基因生物 VITA 反过来接管地球，用首饰呈现这场生态反扑。",
  "culture": ["思辨设计（Speculative Design）", "人类中心主义批判", "生态伦理", "基因工程与合成生物学"],
  "cultureNote": "思辨设计的关键在于「可信的虚构」：1500 年后地磁衰退导致辐射——这个设定有真实的科学前提（地磁确实在减弱）。有了科学锚点，后面的末世想象才不悬浮。而「VITA 的反叛实则是地球生态对人类中心主义的技术反扑」这一句，把科幻上升为伦理批判。",
  "symbols": [
      {
          "src": "地磁衰退与太阳辐射",
          "way": "近未来科学设定",
          "out": "世界观起点"
      },
      {
          "src": "基因融合生物 VITA",
          "way": "首饰造型与材质",
          "out": "可佩戴的虚构物种"
      },
      {
          "src": "吞噬并重组万物基因",
          "way": "形态的增殖与变异",
          "out": "视觉语言"
      },
      {
          "src": "进化裁判权的转移",
          "way": "叙事内核",
          "out": "思辨命题"
      }
  ],
  "transMethod": ["品牌叙事", "形态转译", "材料转译", "概念转译"],
  "presentation": ["首饰实物", "概念渲染", "世界观文本", "展板排版"],
  "presCat": "实物/产品",
  "presNote": "首饰加世界观文本双轨，视觉上强调「标本感」——像是从那个未来带回来的实物证据。",
  "narration": "设定 — 推演 — 揭示",
  "narrMethod": "媒介—角色—传播",
  "narrBreak": {
      "opening": "直接抛出时间点（1500 年后）与灾难（地磁衰退、太阳辐射），是硬科幻式的冷开场。",
      "structure": "时间设定 → 灾难 → 人类应对（迁居地下、创造 VITA）→ 误判（低估进化潜力）→ 反转（自主进化、反噬人类）→ 新秩序 → 揭示。",
      "rhetoric": "通篇用短句推进，节奏像纪录片旁白；最后一句「进化的裁判权将降临在新的生命体上」是全篇唯一的抒情，也是立意所在。",
      "closing": "落在「进化的裁判权将降临在新的生命体上」——不给希望，只给判断。"
  },
  "narrNote": "罕见的纯虚构自述：不谈工艺、不谈用户、不谈市场，通篇推进世界观。在毕设展上风险最高，也最像一件艺术作品。",
  "desc": "1500年后，地磁衰退，太阳辐射席卷地表，地球迈入蚀纪元。人类迁居地下，为延续物种创造出基因融合生物VITA，却低估了其进化潜力与失控环境对科技的扭曲。VITA实现自主基因进化，反噬人类，重塑生态规则，吞噬并重组万物基因，成为蚀纪元新主宰。其诞生与反叛，实则是地球生态对人类中心主义的技术反扑——进化的裁判权将降临在新的生命体上。",
  "kw": ["思辨设计", "VITA", "蚀纪元", "基因", "末世", "人类中心主义", "生态", "首饰", "反乌托邦"],
  "imgs": ["a17_00.jpg"]
  },
{
  "id": "a18",
  "year": "2025",
  "title": "飘戏",
  "sub": "实验影像与场域装置",
  "authors": "李允翘",
  "teachers": "梁嘉、王时音",
  "topic": "在地创生 — 叙事性产品与品牌设计",
  "type": "实验影像 · 场域装置",
  "typeCat": "影像/内容",
  "motif": "非遗与手工技艺",
  "highlight": "抓住飘色最戏剧性的出身：清代粤剧受限，民间就把戏「抬到空中」继续演。于是作品本身也选择不在剧场里——用影像和场域装置重构那场穿越时空的演出。",
  "concept": "用实验影像与场域装置，重现沙湾飘色诞生的那个历史瞬间——粤剧被禁，戏在天上继续演。",
  "culture": ["沙湾飘色（国家级非遗）", "清代粤剧禁演史", "岭南民间赛会", "民间的文化韧性"],
  "cultureNote": "飘色是「凌空飘立的戏剧造型」，孩子被支架托在空中扮演戏曲人物。它的起源与清代粤剧受禁直接相关——民间用「抬着的戏」绕过禁令。这本身就是一次精彩的历史级文化转译，作者做的只是把它重新讲出来。",
  "symbols": [
      {
          "src": "飘色的凌空造型",
          "way": "影像与装置的空间语言",
          "out": "悬浮感与仪式感"
      },
      {
          "src": "「以飘代戏」的历史情境",
          "way": "影像叙事",
          "out": "时空穿越的体验"
      },
      {
          "src": "粤剧的戏曲精神",
          "way": "视觉化转译",
          "out": "当代艺术语言"
      }
  ],
  "transMethod": ["视觉转移", "媒介转换", "概念转译"],
  "presentation": ["实验影像", "场域装置", "展陈现场", "展板排版"],
  "presCat": "空间/装置/展陈",
  "presNote": "以影像加装置的现场呈现为主，作品不是物件，而是一段被重构的情境。",
  "narration": "起源 — 媒介 — 体验 — 共鸣",
  "narrMethod": "背景—转译—应用",
  "narrBreak": {
      "opening": "先交代灵感（沙湾飘色），紧接着给出历史成因（清代粤剧受限、以飘色代戏），出手很快。",
      "structure": "灵感 → 历史成因 → 媒介（实验影像与场域装置）→ 手法（重构历史情境）→ 语言（视觉化）→ 体验（穿越时空）→ 目的。",
      "rhetoric": "「以飘色代戏」五字概括了一段复杂文化史，是全篇最高效的表达；「穿越时空」点明体验设计的核心。",
      "closing": "「唤起对传统艺术形式的再认知与共鸣」——「再认知」排在「共鸣」前面，说明要的不只是感动。"
  },
  "narrNote": "最简洁的一篇：四句话讲完源流、媒介、手法、目标，没有废话，信息密度极高。",
  "desc": "作品以广东沙湾非遗“飘色”为灵感，源于清代粤剧受限，民间以飘色代戏传承戏曲精神。通过实验影像与场域装置，重构特定历史情境，运用视觉化语言营造“穿越时空”的沉浸式文化体验，唤起对传统艺术形式的再认知与共鸣.",
  "kw": ["飘色", "沙湾", "粤剧", "实验影像", "场域装置", "非遗", "岭南", "沉浸式"],
  "imgs": ["a18_00.jpg"]
  },
{
  "id": "a19",
  "year": "2025",
  "title": "游牧之路",
  "sub": "桌游设计",
  "authors": "官睿茵",
  "teachers": "李健",
  "topic": "新疆阿勒泰地方文旅艺术创新",
  "type": "桌游 · 生态议题设计",
  "typeCat": "游戏/桌游",
  "motif": "当代媒介与流行文化",
  "highlight": "把桌游最不起眼的「格子」变成批判对象——那些规整方格正好是草场被围栏、公路、矿区切碎的样子，玩家每走一格，都在复演一次游牧的受限。",
  "concept": "用桌游里最常见的格子地图，隐喻草原正在被切割成碎片的现实。",
  "culture": ["阿勒泰哈萨克游牧文化", "游牧生态观（逐水草而居的秩序）", "草原碎片化与生态失衡", "城市化冲击"],
  "cultureNote": "游牧文明的核心不是「到处走」，而是「与草原承载力相平衡的移动秩序」。当草场被围栏和建设用地切碎，这套秩序就失效了。作者用桌游机制让抽象的「碎片化」变得可以亲手摸到——媒介自觉性很强的一步。",
  "symbols": [
      {
          "src": "桌游的格子地图",
          "way": "草原碎片化的隐喻",
          "out": "版图设计"
      },
      {
          "src": "四季转场",
          "way": "回合与阶段",
          "out": "游牧节奏的机制化"
      },
      {
          "src": "突发状况（雪灾、旱情、草场退化）",
          "way": "事件卡",
          "out": "生存的不确定性"
      },
      {
          "src": "游牧生态观",
          "way": "胜利条件",
          "out": "价值观的植入"
      }
  ],
  "transMethod": ["产品语义", "形态转译", "概念转译", "造型挪用"],
  "presentation": ["桌游实物", "版图与卡牌", "规则说明", "展板排版"],
  "presCat": "实物/产品",
  "presNote": "以完整桌游组件呈现，版图本身的视觉（被切割的格子）就是核心论点。",
  "narration": "议题 — 媒介 — 机制 — 唤起",
  "narrMethod": "其他",
  "narrBreak": {
      "opening": "以社会变迁与城市化为背景，先说清楚「什么东西正在消失」，是批判式开篇。",
      "structure": "背景议题（游牧秩序被打破）→ 媒介选择（游戏）→ 核心隐喻（格子地图 = 草原碎片化）→ 机制（四季游牧、突发状况）→ 目的。",
      "rhetoric": "「将…转化为对…的隐喻」是全篇的方法论句；「秩序」一词用得准，点出游牧不是随意移动。",
      "closing": "「唤起公众对草原生态失衡和游牧文化变迁的关注，并理解其背后的游牧生态观与生存智慧」——关注加理解，两个层级。"
  },
  "narrNote": "议题批判型：先说世界坏了，再说我用什么方式让你感受到。隐喻的自觉性是全篇最大的亮点。",
  "desc": "随着社会变迁和城市化进程加快，阿勒泰游牧传统生活方式及其与草原相平衡的秩序正在被打破。本设计以游戏作为媒介，将桌游中典型的格子地图转化为对现实草原碎片化现象的隐喻。通过模拟牧民四季的游牧生活和应对不同的突发状况，唤起公众对草原生态失衡和游牧文化变迁的关注，并理解其背后的游牧生态观与生存智慧。",
  "kw": ["游牧", "阿勒泰", "桌游", "草原碎片化", "生态", "哈萨克", "隐喻", "生存智慧"],
  "imgs": ["a19_00.jpg"]
  },
{
  "id": "a20",
  "year": "2025",
  "title": "海绵显形研究 & 香氛系列",
  "sub": "材料感知设计",
  "authors": "陈澄",
  "teachers": "张剑",
  "topic": "本质与主观 — 产品感知设计",
  "type": "材料研究 · 感知设计",
  "typeCat": "产品设计",
  "motif": "物/材料/可持续",
  "highlight": "起点是一次手感意外：剪刀裁过不留痕迹，手指一按却无中生有。整件作品由此变成对「弹性极限」的追问——把材料最微不足道的物理特性，做成了一整套可被反复玩味的形态研究。",
  "concept": "从「剪刀剪海绵不留痕、手指按压却显形」这个偶然发现出发，系统研究海绵在弹性极限处的显形可能。",
  "culture": ["材料感知研究", "日常物的非常规观察", "弹性与触觉美学", "五感设计"],
  "cultureNote": "张剑组的共同气质是——不谈文化符号，只谈感知本身。海绵是最平庸的材料（包装填充、清洁工具），作者对它做的事是：停止把它当功能材料，开始把它当可被观察的对象。这是设计研究最本源的动作。",
  "symbols": [
      {
          "src": "剪刀裁剪（不留痕迹） vs 手指按压（显形）",
          "way": "对照实验",
          "out": "研究起点"
      },
      {
          "src": "手势介入 × 裁剪路径",
          "way": "参数化组合",
          "out": "显形的无数种可能"
      },
      {
          "src": "弹性极限",
          "way": "形态边界",
          "out": "系列化呈现"
      },
      {
          "src": "香氛的单一嗅觉",
          "way": "并入视觉、听觉、触觉",
          "out": "五感体验"
      }
  ],
  "transMethod": ["产品语义", "功能嫁接", "形态转译", "材料转译", "概念转译"],
  "presentation": ["材料实验样本", "形态研究图", "香氛产品", "展板排版"],
  "presCat": "平面/视觉/图像",
  "presNote": "以「研究样本阵列」呈现，强调数量与差异——一面墙的形态变体比单件成品更有说服力。",
  "narration": "发现 — 追问 — 方法 — 延展",
  "narrMethod": "材料—形态—感知",
  "narrBreak": {
      "opening": "从一个极其具体的偶然发现说起（剪刀不留痕、手指能显形），是全篇最有画面感的一句。",
      "structure": "偶然发现 → 追问 → 方法（手势介入 × 裁剪路径）→ 目标（弹性极限处的显形可能）→ 延展（香氛系列、五感）。",
      "rhetoric": "「无中生有」「意料之外」「无数种可能」——用一组表示「涌现」的词，把材料实验写出惊喜感。",
      "closing": "以香氛系列收尾，把材料研究接回产品设计，形成「研究—应用」闭环。"
  },
  "narrNote": "研究者口吻：全篇在描述一个探索过程，而不是推销一个结果。这类自述在毕设里最诚实，也最考验作品的视觉呈现。",
  "desc": "《海绵显形研究》灵感源于偶然发现剪刀裁剪海绵不留痕迹，而手指按压却能无中生有地显现出优美形态，因此通过不同的手势介入与裁剪路径相互作用，探索海绵在弹性极限处令人意料之外的显形的无数种可能。《香氛系列》以五件产品为载体，突破单一嗅觉体验，将视觉、听觉、触觉融入香氛设计，构建全新的五感体验。",
  "kw": ["海绵", "材料研究", "感知设计", "弹性极限", "显形", "香氛", "五感", "张剑"],
  "imgs": ["a20_00.jpg"]
  },
{
  "id": "a21",
  "year": "2025",
  "title": "印象的延展",
  "sub": "产品感知设计",
  "authors": "张铭轩",
  "teachers": "张剑",
  "topic": "本质与主观 — 产品感知设计",
  "type": "感知设计 · 产品系列",
  "typeCat": "产品设计",
  "motif": "物/材料/可持续",
  "highlight": "开头六句像一首散文诗：青竹高洁、泉水澄澈、红砖布满烟渍、图钉散乱而棋子自成秩序、花绳翻出形状却短暂——先写出物在生活中的「名声」，再让设计去兑现或颠覆它。",
  "concept": "把青竹、泉水、红砖、图钉、棋子、花绳在日常生活中留下的「印象」作为设计素材，让产品替它们把话说完。",
  "culture": ["日常物的感知印象", "物的「性格」", "文人式的观物传统", "材质语义"],
  "cultureNote": "这是全部作品里最「文学」的一件。它处理的对象不是文化符号，而是「印象」——人们对物的既有认知。这种思路接近中国传统的「格物」：通过观察物来抵达某种道理。",
  "symbols": [
      {
          "src": "青竹（自然高洁）",
          "way": "产品化",
          "out": "印象的物化"
      },
      {
          "src": "泉水（清凉澄澈）",
          "way": "产品化",
          "out": "印象的物化"
      },
      {
          "src": "红砖（质实耐脏、遍布烟渍）",
          "way": "产品化",
          "out": "印象的物化"
      },
      {
          "src": "图钉（散乱） vs 棋子（规整秩序）",
          "way": "对照",
          "out": "秩序与失序"
      },
      {
          "src": "花绳（短暂的美好）",
          "way": "产品化",
          "out": "时间性"
      }
  ],
  "transMethod": ["产品语义", "材料转译", "概念转译"],
  "presentation": ["四件产品实物", "材质与场景", "展板排版"],
  "presCat": "实物/产品",
  "presNote": "四件成组，每件对应一种「印象」，靠并置产生对照关系。",
  "narration": "列举 — 点题 — 意图",
  "narrMethod": "其他",
  "narrBreak": {
      "opening": "六个并列的观察句，句句具体、有质感、带判断，是全文最精彩的部分。",
      "structure": "印象列举（六种物及其性格）→ 点题 → 作品构成（四件）→ 意图（遣用既成印象、以产品为载体、使意义延伸）→ 目标。",
      "rhetoric": "分号串联的排比，节奏像散文；「而」「却」等转折词让每个印象都有内部张力（红砖质实耐脏，常见其遍布烟渍）。",
      "closing": "「彰显出本身的特质」——设计的任务不是赋予，而是让物自己显形。"
  },
  "narrNote": "最像文学作品的一篇：用六个具体的观察句开场，把方法论藏在感性描述后面，读起来毫不费力却信息完整。",
  "desc": "青竹给人以自然高洁的印象，而泉水清凉澄澈；红砖质实耐脏，常见其遍布烟渍；图钉时常散乱而棋子规整自成秩序；花绳翻出种种形状却只是短暂的美好......种种事物在生活中给我们留下了它们的印象。本系列毕业设计由四件作品组成，旨在通过设计实践遣用事物既成的印象，以产品为载体使其意义得以延申与发展，并彰显出本身的特质。",
  "kw": ["印象", "感知设计", "青竹", "红砖", "图钉", "花绳", "日常物", "格物", "张剑"],
  "imgs": ["a21_00.jpg"]
  },
{
  "id": "a22",
  "year": "2026",
  "title": "微光构造",
  "sub": "科创文化艺术衍生品",
  "authors": "卢越",
  "teachers": "郜洵、梁嘉、袁泽强",
  "type": "文创衍生品 · 概念叙事",
  "typeCat": "文创/衍生品",
  "motif": "当代媒介与流行文化",
  "highlight": "把「纸飞机」当成科创者的共同原点——每个人童年折过的第一架飞机，就是人生中第一个发明。用一个几乎所有人都有过的动作，替一整个群体写了个出身故事。",
  "concept": "以纸飞机为意象，把科创者反复试错的过程折进一套文化衍生品里。",
  "culture": ["科创文化与创造者社群", "纸飞机作为创造力的原型意象", "折叠与手工"],
  "cultureNote": "纸飞机是极少数跨越文化的「童年发明」：一张纸、一次折叠、一次投掷，完成了从无到有的全过程。作者把它当作科创者的精神图腾——不是为了造型可爱，而是因为它天然携带「试错—投掷—再试」的行为结构。",
  "symbols": [
      {
          "src": "纸飞机（童年第一个发明）",
          "way": "造型母题",
          "out": "衍生品主视觉"
      },
      {
          "src": "反复折叠、一次次扔向天空",
          "way": "迭代行为的物化",
          "out": "产品结构与系列关系"
      },
      {
          "src": "星星点点的光（微光）",
          "way": "材料与光效",
          "out": "「微光构造」的视觉落点"
      },
      {
          "src": "拼合与构造",
          "way": "模块化组合",
          "out": "可拼装的产品形态"
      }
  ],
  "transMethod": ["品牌叙事", "形态转译", "材料转译", "概念转译", "行为绑定"],
  "presentation": ["衍生品实物", "场景渲染", "展板排版"],
  "presCat": "实物/产品",
  "presNote": "以系列化衍生品呈现，靠「拼合与构造」的组件关系呼应主题里的折叠动作。",
  "narration": "意象 — 群体 — 升华",
  "narrMethod": "人群—意象—体验",
  "narrBreak": {
      "opening": "从一个几乎所有人共有的童年经验起手（人生第一个发明是一架纸飞机），不做定义先做共情。",
      "structure": "共同经验 → 行为复现（反复折叠、一次次扔向天空）→ 命名（科创者）→ 意象（微光生于微小尝试）→ 升华（微光汇聚成照向未来的光）。",
      "rhetoric": "通篇散文笔调，用「或许」「一次又一次」「终将」制造时间厚度；几乎没有功能描述。",
      "closing": "落在「成为照向未来的光」，把个人坚持上升为群体命运。"
  },
  "narrNote": "抒情型表达：全篇在经营一个意象，而不是介绍一件产品。感染力来自共情，代价是读完仍不知道具体做了什么物件。",
  "desc": "每位科创者人生中的第一个发明，或许都是一架纸飞机。从空白开始，他们反复“折叠”手中的物件，一次又一次将最新的“纸飞机”扔向天空。最终童年的飞机驶向更远的天空，充满想象和魄力的人们有了一个新的名字——科创者。星星点点的光，诞生于一次次微小的尝试中。它藏在拼合与构造之间，也映照着科创者尝试探索、持续前行的精神。每一件作品都是一种回应，承载着不同的理想与心声。那些细微而坚定的坚持，终将在积累中汇聚，成为照向未来的光。",
  "kw": ["纸飞机", "科创", "衍生品", "微光", "折叠", "试错", "文创"],
  "imgs": ["a22_00.jpg", "a22_01.jpg", "a22_02.jpg", "a22_03.jpg"]
  },
{
  "id": "a23",
  "year": "2026",
  "title": "“工具”系列",
  "sub": "人体护理品牌",
  "authors": "谢宇旸",
  "teachers": "梁嘉、袁泽强",
  "type": "品牌设计 · 批判性设计",
  "typeCat": "视觉/信息",
  "motif": "社会议题与群体关怀",
  "highlight": "把维修工具绑到身体护理上——用「动作共性」制造认知错位：扳手的拧、刷子的刷、锤子的敲，本来就都是护理身体的动作。当工具反过来服务人体，被暗示的是「人也是工具」。",
  "concept": "借维修工具与身体护理的动作共性制造认知错位，提出「人作为工具」的身份质询。",
  "culture": ["批判性设计（Critical Design）", "工具理性与人的异化", "维修文化", "当代职场隐喻"],
  "cultureNote": "这件作品的锋利在于它不是解决问题，而是提出质询。作者用了批判性设计的经典手法：把一个系统（工具）的逻辑强行移植到另一个系统（人体）上，让被遮蔽的前提显形——当「效率」「维护」「性能」这些词被用在人身上时，人已经被功能化了。",
  "symbols": [
      {
          "src": "维修工具（扳手、锤、刷）",
          "way": "造型挪用",
          "out": "护理产品外观"
      },
      {
          "src": "动作共性（拧、刷、敲）",
          "way": "行为绑定",
          "out": "使用方式与认知错位"
      },
      {
          "src": "「人体需要维修」",
          "way": "品牌叙事",
          "out": "产品语义"
      },
      {
          "src": "「人作为工具」",
          "way": "价值质询",
          "out": "概念内核"
      }
  ],
  "transMethod": ["产品语义", "功能嫁接", "品牌叙事", "形态转译", "概念转译"],
  "presentation": ["产品实物", "品牌视觉", "展板排版"],
  "presCat": "实物/产品",
  "presNote": "以品牌化系列呈现，视觉上刻意保留工具的工业感，让错位在看见的第一眼就发生。",
  "narration": "灵感 — 手法 — 反目标 — 质询",
  "narrMethod": "批判—重构—质询",
  "narrBreak": {
      "opening": "直接给出灵感（「维修工具用于人体护理」的想象），一句话说清错位关系。",
      "structure": "灵感 → 手法（工具造型 × 身体护理行为绑定）→ 机制（动作共性制造认知错位）→ 否定设计目标（不以功能优化为目标）→ 质询 → 追问。",
      "rhetoric": "「不以…为目标，而是…」这个否定句式是全篇的转折枢纽，主动放弃功能叙事换取批判空间；结尾用开放式追问代替结论。",
      "closing": "以问句收尾，拒绝给答案——批判性设计最标准的收尾方式。"
  },
  "narrNote": "罕见的「反功能」自述：明确声明不优化功能。这在毕设里是极大冒险，也正因如此，它从一堆「解决痛点」的作品里跳了出来。",
  "desc": "作品以“维修工具用于人体护理”的想象为灵感，通过将工具造型与身体护理行为绑定，以动作共性制造认知错位。设计不以功能优化为目标，而是借由产品形态提出对“人作为工具”的身份反思与价值质询，探讨当工具与人均被功能化后，我们如何重新理解自身存在。",
  "kw": ["批判性设计", "工具", "人体护理", "认知错位", "异化", "品牌", "质询"],
  "imgs": ["a23_00.jpg", "a23_01.jpg", "a23_02.jpg"]
  },
{
  "id": "a24",
  "year": "2026",
  "title": "占嬉",
  "sub": "基于传统占卜文化研究的体验产品设计",
  "authors": "范彪炳",
  "teachers": "王柳庄",
  "type": "体验产品 · 文化转译",
  "typeCat": "产品设计",
  "motif": "礼俗/节庆/仪式",
  "highlight": "「占者，占之喜。嬉者，嬉见道。」八字拆解法：把占卜里的宿命感、神圣感、规则门槛全部剥离，只留下「面对未知时一点顽皮的仪式」。把玄学降维成日常情绪工具的教科书操作。",
  "concept": "剥离占卜的沉重宿命感与繁复门槛，把它重塑成一种轻盈、直觉、日常的体验产品。",
  "culture": ["传统占卜文化", "游嬉精神与逍遥（道家）", "当代情绪自助", "仪式感消费"],
  "cultureNote": "与 a14「宇宙传讯」（占卜 × 茶饮）构成一组对照：同样处理占卜，宇宙传讯走「心理暗示与情感安抚」的功能论证，占嬉走的是「嬉」的美学立场。占嬉更狠的一点在于连「答案」本身也放弃了——不再追求绝对答案，只保留面对神秘时的一点顽皮。",
  "symbols": [
      {
          "src": "占（叩问天地的渴望）",
          "way": "保留提问行为",
          "out": "产品的核心互动"
      },
      {
          "src": "嬉（游于物外的逍遥）",
          "way": "视觉与语气的轻盈化",
          "out": "产品的性格"
      },
      {
          "src": "宿命感、仪式感、规则门槛",
          "way": "主动剥离",
          "out": "降低使用门槛"
      },
      {
          "src": "「占以游嬉，得之皆喜」",
          "way": "八字箴言",
          "out": "品牌与体验的收束"
      }
  ],
  "transMethod": ["功能嫁接", "情绪转译", "行为绑定", "行为转译"],
  "presentation": ["产品实物", "视觉系统", "展板排版"],
  "presCat": "实物/产品",
  "presNote": "以体验产品加视觉系统呈现，语气的轻盈必须靠视觉来兑现——这是最难的部分。",
  "narration": "拆字 — 对立 — 剥离 — 收束",
  "narrMethod": "批判—重构—质询",
  "narrBreak": {
      "opening": "用拆字法开场（占者，占之喜。嬉者，嬉见道），八字立骨，格调立刻拉高。",
      "structure": "拆字定义 → 对立阐释（占=叩问 / 嬉=逍遥）→ 剥离动作（去掉宿命感、仪式感、门槛）→ 重塑（轻盈、直觉、日常）→ 反转（不再追求绝对答案）→ 收束。",
      "rhetoric": "文言句式与白话交替，形成独特节奏；「剥离」「重塑」两个动词是方法论核心；「这便足够了」一句突然收力，非常松弛。",
      "closing": "「占以游嬉，得之皆喜」——八字回扣开头，完成闭环。"
  },
  "narrNote": "最有文学性的一篇：用文言拆字建立格调，用白话完成方法论，再用八字收束。文字本身就是作品的一部分。",
  "desc": "占者，占之喜。嬉者，嬉见道。占，是面对未知时叩问天地的渴望；嬉，是游于物外的逍遥。我们剥离了传统占卜中沉重的宿命感、肃穆的仪式感与繁复的规则门槛，将其重塑为一种轻盈、直觉、日常的体验产品。它不再追求绝对的答案，而是人们面对神秘时，一点顽皮的仪式。这便足够了。占以游嬉，得之皆喜。",
  "kw": ["占卜", "占嬉", "体验产品", "仪式感", "逍遥", "情绪", "转译"],
  "imgs": ["a24_00.jpg", "a24_01.jpg", "a24_02.jpg"]
  },
{
  "id": "a25",
  "year": "2026",
  "title": "？！",
  "sub": "",
  "authors": "何晓仪",
  "teachers": "王柳庄、张剑",
  "type": "感知设计 · 幽默设计",
  "typeCat": "产品设计",
  "motif": "物/材料/可持续",
  "highlight": "作品名就是标点符号——「？」是打破预期，「！」是用户会心一笑的瞬间。把一整个设计流程压缩成两个字符，这是张剑组最擅长的极简。",
  "concept": "打破一个「理所当然」的预期，然后交由用户在会心一笑的瞬间完成消解。",
  "culture": ["日常物的预期与惯性", "幽默设计（Humour Design）", "感知设计", "张剑「本质与主观」方法论"],
  "cultureNote": "与 a20、a21 同属张剑的「本质与主观」脉络：不处理文化符号，只处理感知本身。这一件处理的是「预期」——人对物的默认判断。设计的动作不是添加，而是在正确的地方制造一个断裂。",
  "symbols": [
      {
          "src": "「理所当然」（日常惯性）",
          "way": "识别与选择",
          "out": "设计的切入点"
      },
      {
          "src": "「？」（预期被打破的瞬间）",
          "way": "形态上的意外",
          "out": "第一层体验"
      },
      {
          "src": "「！」（会心一笑的消解）",
          "way": "用户的自我完成",
          "out": "第二层体验"
      },
      {
          "src": "系列化",
          "way": "多个物件各打破一种预期",
          "out": "作品构成"
      }
  ],
  "transMethod": ["产品语义", "形态转译", "情绪转译", "概念转译", "行为绑定"],
  "presentation": ["系列实物", "使用场景", "展板排版"],
  "presCat": "实物/产品",
  "presNote": "以系列小品呈现，每件对应一次预期破坏；靠「看见—反应」的即时性说话。",
  "narration": "观察 — 机制 — 交付",
  "narrMethod": "问题—机制—价值",
  "narrBreak": {
      "opening": "「我们每天都被无数『理所当然』包围」——从日常观察切入，一句话建立共鸣。",
      "structure": "观察（理所当然）→ 动作（打破一个预期）→ 交付（交由用户消解）→ 机制（从？到！）→ 祝愿。",
      "rhetoric": "全篇只有四句，没有术语、没有功能、没有用户研究；「会心一笑」是唯一的体验指标；最后一句把作品从设计降回游戏。",
      "closing": "以「希望大家玩得开心！」收尾——极短，且刻意不升华。"
  },
  "narrNote": "最短的自述之一：拒绝一切专业词汇，用愿望代替论证。极自信也极冒险——它赌的是作品本身足够好笑。",
  "desc": "我们每天都被无数“理所当然”包围。本系列尝试打破一个“理所当然”的预期，然后交由用户在会心一笑的瞬间完成消解。从“？”到“！”便是从打破预期到消解的这一过程。希望大家玩得开心！",
  "kw": ["幽默设计", "预期", "感知", "张剑", "日常", "会心一笑"],
  "imgs": ["a25_00.jpg", "a25_01.jpg", "a25_02.jpg", "a25_03.jpg", "a25_04.jpg"]
  },
{
  "id": "a26",
  "year": "2026",
  "title": "前童十四夜",
  "sub": "",
  "authors": "宋欣桐、余清清",
  "teachers": "丁熊、刘珊、黄河",
  "type": "服务设计 · 非遗活化",
  "typeCat": "社会创新/服务",
  "motif": "非遗与手工技艺",
  "highlight": "不改造民俗，只改造「参与方式」——明确声明不破坏古镇风貌与民俗仪式，用轻量化服务设计解决「好看但难懂、热闹但难融」，这是非遗活化里最克制也最专业的姿态。",
  "concept": "为宁海前童元宵行会做一套节庆体验方案，让古老非遗从「被观看」走向「可参与、可理解、可传播」。",
  "culture": ["宁海前童元宵行会（国家级非遗）", "浙东古镇民俗", "文旅融合", "服务设计"],
  "cultureNote": "前童行会是罕见的「活着的行会」——不是舞台表演，而是全镇参与的年度仪式。这类活态非遗最怕两件事：被旅游化掏空内核，或因难以理解而变成旁观。作者的解法是在不改变仪式的前提下，为外来者加一层「理解的接口」。",
  "symbols": [
      {
          "src": "元宵行会的仪式流程",
          "way": "体验节点设计",
          "out": "服务触点"
      },
      {
          "src": "「好看但难懂、热闹但难融」",
          "way": "问题清单",
          "out": "设计目标"
      },
      {
          "src": "轻量化、沉浸式、高互动",
          "way": "不改变内核的介入",
          "out": "方案手段"
      },
      {
          "src": "社交打卡、亲子互动",
          "way": "对接当代游客需求",
          "out": "落地的可行性"
      }
  ],
  "transMethod": ["品牌叙事", "行为绑定", "行为转译", "造型挪用"],
  "presentation": ["服务系统图", "用户体验旅程", "场景渲染", "展板排版"],
  "presCat": "渲染/模型",
  "presNote": "典型服务设计输出：系统图、旅程图、触点设计三件套，强调方案落地与可复制。",
  "narration": "载体 — 问题 — 手段 — 双重价值",
  "narrMethod": "问题—机制—价值",
  "narrBreak": {
      "opening": "先立载体（国家级非遗前童元宵行会）再立问题（传承与活化），规格很高。",
      "structure": "载体 → 问题聚焦 → 手段（服务设计与体验创新）→ 产出 → 目标（从被观看到可参与可理解可传播）→ 边界声明（不破坏风貌与仪式）→ 手段细化 → 双重价值。",
      "rhetoric": "「从…走向…」是本作的核心句式；「好看但难懂、热闹但难融」八个字的对仗，把问题诊断得极其精准。",
      "closing": "落在「可落地、可复制的创新路径」与「文化新名片」，兼顾专业与宣传口径。"
  },
  "narrNote": "成熟的服务设计自述：有边界意识（明确说不破坏什么）、有双重价值（游客与传承方都照顾到）、有可复制性。专业度最高的一档。",
  "desc": "本作品以国家级非物质文化遗产 —— 宁海前童元宵行会为核心创作载体，聚焦传统民俗在当代文旅场景中的传承与活化问题，通过服务设计与体验创新，为前童古镇打造一套兼具文化底蕴、互动趣味与落地性的节庆体验方案，让古老非遗从“被观看”走向“可参与、可理解、可传播”。本设计坚守非遗核心内核，不破坏古镇风貌与民俗仪式，以轻量化、沉浸式、高互动的服务设计，解决传统民俗“好看但难懂、热闹但难融”的问题，既满足当代游客对文化体验、社交打卡、亲子互动的需求，也为非遗传承、古镇文旅活化提供可落地、可复制的创新路径，让前童十四夜成为有温度、有故事、可参与的文化新名片。",
  "kw": ["前童", "元宵行会", "非遗", "服务设计", "文旅", "活化", "宁海", "体验"],
  "imgs": ["a26_00.jpg", "a26_01.jpg", "a26_02.jpg", "a26_03.jpg"]
  },
{
  "id": "a27",
  "year": "2026",
  "title": "盒藏南沙",
  "sub": "",
  "authors": "赵悦如",
  "teachers": "庄嘉菁",
  "type": "文创产品 · 地方记忆",
  "typeCat": "文创/衍生品",
  "motif": "自然生态与地方景观",
  "highlight": "外壳是九龙王庙与供台，内盒拆下来是便携工具盒，里面装的是水神法器、祭神贡品转译成的「微观物证」——把一整座水滨城区的记忆，压缩进一个可以带走的盒子。",
  "concept": "以南沙水文化为线索，用套盒摆件嵌套便携工具的形式，收藏南沙的地方记忆。",
  "culture": ["南沙水文化", "九龙王庙与民间水神信仰", "祭神贡品", "岭南水乡日常意象"],
  "cultureNote": "南沙是珠江口的冲积城区，水既是生存环境也是信仰对象。作者没有选择宏大的「水文化叙事」，而是收集「细碎而具体的日常意象」——法器、贡品、庙宇形态，把它们当成考古学意义上的「物证」来转译。",
  "symbols": [
      {
          "src": "九龙王庙与供台",
          "way": "外壳造型",
          "out": "套盒主体形态"
      },
      {
          "src": "水神法器",
          "way": "微型化转译",
          "out": "便携工具的功能形态"
      },
      {
          "src": "祭神贡品",
          "way": "微观物证",
          "out": "内盒收纳的器物"
      },
      {
          "src": "可拆下的内盒",
          "way": "嵌套结构",
          "out": "从摆件到便携的转换"
      }
  ],
  "transMethod": ["功能嫁接", "品牌叙事", "形态转译", "行为绑定", "行为转译"],
  "presentation": ["产品实物", "结构拆解", "展板排版"],
  "presCat": "实物/产品",
  "presNote": "以「套盒 + 内盒 + 微观物证」三层结构呈现，重点展示嵌套关系与拆卸动作。",
  "narration": "线索 — 结构 — 转译 — 意义",
  "narrMethod": "背景—转译—应用",
  "narrBreak": {
      "opening": "「以南沙水文化为线索」——先给文化坐标，再给物（套盒摆件嵌套便携工具）。",
      "structure": "文化线索 → 物的形态 → 外壳来源（九龙王庙与供台）→ 内盒功能（可拆）→ 内容（法器、贡品转译的微观物证）→ 意义。",
      "rhetoric": "「细碎而具体的日常意象」「微观物证」——用考古学语汇描述文创，把小物件说成有证据价值的东西；「藏」字点题。",
      "closing": "「呈现南沙水滨城区藏于器物中的地方记忆」——「藏」字回扣标题。"
  },
  "narrNote": "器物叙事型：全篇在讲「这个盒子装了什么、为什么装这些」。信息密度高，但几乎不讲用户与使用场景。",
  "desc": "《盒藏南沙》以南沙水文化为线索，作品为套盒摆件嵌套便携工具设计。外壳取意九龙王庙与供台形态，内盒可拆下成为便携工具小盒，收纳由水神法器、祭神贡品转译而来的微观物证。作品以细碎而具体的日常意象，呈现南沙水滨城区藏于器物中的地方记忆。",
  "kw": ["南沙", "水文化", "九龙王庙", "套盒", "物证", "地方记忆", "文创", "岭南"],
  "imgs": ["a27_00.jpg", "a27_01.jpg", "a27_02.jpg"]
  },
{
  "id": "a28",
  "year": "2026",
  "title": "新莨乡记",
  "sub": "香云纱非遗研学体系",
  "authors": "刘果琳、黄心怡、张可欣、刘馨菲、李东霖",
  "teachers": "王柳庄、彭圣芳、李健",
  "type": "非遗研学 · 乡建设计",
  "typeCat": "其他",
  "motif": "当代媒介与流行文化",
  "highlight": "不做香云纱的产品，做香云纱的「研学体系」——而且按年龄分成三层：青年的五感沉浸、亲子的薯莨实验室、低龄的植物博物。把一门手艺拆成三条进入路径。",
  "concept": "以新兴县香云纱非遗为核心，打造全年龄段分层式的非遗研学体系。",
  "culture": ["香云纱（国家级非遗）", "薯莨（核心植物原料）", "乡村振兴与非遗研学", "乡土手工艺"],
  "cultureNote": "香云纱的困境很典型：认知门槛高、受众窄、体验单一。作者抓住一个少有人注意的点——它其实源自一种植物（薯莨），而植物是可以被观察、种植、实验的。于是「薯莨实验室」这条路径把高高在上的丝绸工艺，接回了土地和儿童的好奇心。",
  "symbols": [
      {
          "src": "香云纱（成品）",
          "way": "保留为高端认知层",
          "out": "云纱五识（青年）"
      },
      {
          "src": "薯莨（原料植物）",
          "way": "科普化、实验化",
          "out": "薯莨实验室（亲子）"
      },
      {
          "src": "植物博物",
          "way": "启蒙化",
          "out": "莨之物语（低龄）"
      },
      {
          "src": "五大原创 IP",
          "way": "视觉体系统合",
          "out": "品牌识别"
      }
  ],
  "transMethod": ["品牌叙事", "角色化"],
  "presentation": ["研学物料", "IP 形象", "农产品包装", "展板排版"],
  "presCat": "平面/视觉/图像",
  "presNote": "以「体系」呈现：三条研学路径 + IP + 包装，靠全景式铺陈证明系统性。",
  "narration": "定位 — 痛点 — 分层 — 结语",
  "narrMethod": "问题—机制—价值",
  "narrBreak": {
      "opening": "先给文化坐标（新兴县香云纱）与原料焦点（深耕薯莨），再给社会目标（乡村振兴）。",
      "structure": "文化定位 → 目标 → 痛点（门槛高、受众窄、体验单一）→ 方案（分层研学体系）→ 三条路径 → IP 与文创 → 农产品包装 → 意义。",
      "rhetoric": "高频使用动宾结构（破解痛点、打造体系、构建视觉、优化包装、赋能传播），节奏紧凑；「破圈传承」这类网络语汇与「高质量发展」这类政策语汇并存。",
      "closing": "落在「助力乡村振兴高质量发展」，把设计接上国家话语。"
  },
  "narrNote": "项目制自述：体量大、模块多、语言偏汇报体。优点是系统性强，缺点是单品深度被摊薄。",
  "desc": "“新莨乡记”立足新兴县香云纱非遗文化，深耕薯莨核心原料，以设计记录乡土手艺、赋能乡村振兴，破解香云纱认知门槛高、受众窄、体验单一的痛点，打造全年龄段分层式非遗研学体系。项目细分三大特色研学小组：面向青年群体的“云纱五识”，依托原创IP打造五感沉浸式趣味体验；针对6-12岁亲子家庭的“薯莨实验室”，以科普、互动、共创形式深化亲子非遗体验；聚焦低龄儿童的“莨之物语”，融合植物博物教育实现非遗启蒙。项目原创五大核心IP构建专属视觉体系，开发多元非遗文创，优化本土农产品包装。以艺术设计赋能非遗传播、研学教育与乡土产业，年轻化重构非遗，让古老手艺破圈传承，助力乡村振兴高质量发展。",
  "kw": ["香云纱", "薯莨", "非遗研学", "乡村振兴", "IP", "分层", "新兴县", "乡土"],
  "imgs": ["a28_00.jpg", "a28_01.jpg", "a28_02.jpg"]
  },
{
  "id": "a29",
  "year": "2026",
  "title": "好运事务所",
  "sub": "岭南吉祥文化 IP 品牌",
  "authors": "张诗垚、陈怡蕾",
  "teachers": "梁嘉、袁泽强",
  "type": "IP 品牌 · 文创设计",
  "typeCat": "潮玩/IP/角色",
  "motif": "当代媒介与流行文化",
  "highlight": "把岭南吉祥文化做成一家「事务所」——不是卖符咒，是开设一家受理好运的机构。「把好运变成一种生活方式」这句 slogan，把民俗信仰翻译成了当代消费语言。",
  "concept": "从岭南传统吉祥文化提取视觉元素，IP 化与潮流化转译成有情绪价值的生活方式品牌。",
  "culture": ["岭南传统吉祥文化", "祈福与兆头民俗", "情绪价值消费", "潮玩与 IP 品牌"],
  "cultureNote": "岭南的吉祥文化本就是一套高度符号化的视觉系统（蝙蝠、鹿、鱼、铜钱、如意纹），它天生就是「图像化的祝福」。作者没有做博物馆式的纹样复刻，而是给它安了一个当代的组织外壳——事务所，让祝福从「求」变成「办」。",
  "symbols": [
      {
          "src": "岭南吉祥纹样（蝠、鹿、鱼、钱纹）",
          "way": "潮流化重绘",
          "out": "IP 视觉系统"
      },
      {
          "src": "「祈福」这一行为",
          "way": "机构化设定（事务所）",
          "out": "品牌世界观"
      },
      {
          "src": "情绪价值",
          "way": "产品定位",
          "out": "文创衍生品的选品逻辑"
      },
      {
          "src": "「把好运变成一种生活方式」",
          "way": "slogan",
          "out": "品牌承诺"
      }
  ],
  "transMethod": ["品牌叙事", "形态转译", "情绪转译", "概念转译", "行为绑定"],
  "presentation": ["IP 形象", "品牌视觉", "文创衍生品", "展板排版"],
  "presCat": "平面/视觉/图像",
  "presNote": "以品牌全案呈现：IP 立绘 + 视觉系统 + 衍生品阵列，重点是商业化的完整度。",
  "narration": "定位 — 提取 — 转译 — 理念",
  "narrMethod": "背景—转译—应用",
  "narrBreak": {
      "opening": "直接给核心 IP 名（好运事务所）与文化来源（岭南传统吉祥文化），一句话完成定位。",
      "structure": "核心 IP → 文化来源 → 转译动作（IP 化与潮流化）→ 产物（情绪价值的生活方式品牌）→ 理念 → 手段（品牌视觉与衍生品）→ 目标。",
      "rhetoric": "「IP 化与潮流化转译」是标准的方法论句式；「情绪价值」是当代消费设计的关键词，用得很准。",
      "closing": "落在「探索传统祈福文化在当代语境中的年轻化表达」，把商业意图说成文化探索。"
  },
  "narrNote": "品牌型自述：篇幅短、结构完整、商业口径清晰。缺点是文化研究被压缩成一句话，读不出具体提取了哪些符号。",
  "desc": "本作品以“好运事务所”为核心IP，从岭南传统吉祥文化中提取视觉元素，进行IP化与潮流化转译，打造具有情绪价值的生活方式品牌。设计以“把好运变成一种生活方式”为理念，通过品牌视觉与文创衍生品设计，探索传统祈福文化在当代语境中的年轻化表达。",
  "kw": ["好运事务所", "岭南", "吉祥文化", "IP", "祈福", "情绪价值", "品牌", "潮流"],
  "imgs": ["a29_00.jpg", "a29_01.jpg", "a29_02.jpg", "a29_03.jpg"]
  },
{
  "id": "a30",
  "year": "2026",
  "title": "罐头猫才",
  "sub": "",
  "authors": "李碧仪",
  "teachers": "王时音",
  "type": "IP 设计 · 社会批判",
  "typeCat": "潮玩/IP/角色",
  "motif": "当代媒介与流行文化",
  "highlight": "把「职场＝流水线」「打工人＝罐头」这个隐喻做成猫——还拉来卡夫卡的异化与沃霍尔的机械复制当理论后盾。四款 IP 配幽默语录，用玩笑消解重复日常的窒息感。",
  "concept": "借机械复制时代的文化特征与个体异化现象，用猫形象与幽默语录消解青年群体的机械化生存困境。",
  "culture": ["机械复制时代（本雅明）", "卡夫卡的异化书写", "沃霍尔的波普复制", "当代职场与「打工人」话语"],
  "cultureNote": "与 a07「躺平照明局」形成有趣对照：同样是形象 + 当代职场梗，躺平照明局走考古文物的路径，罐头猫才走艺术理论的路径。后者野心更大——它把「机械复制」这个艺术史概念直接换算成了青年的生存状态。",
  "symbols": [
      {
          "src": "罐头（流水线产品）",
          "way": "猫的形象容器",
          "out": "「罐头猫才」主视觉"
      },
      {
          "src": "机械复制",
          "way": "四款形象的重复与微差",
          "out": "视觉语言"
      },
      {
          "src": "卡夫卡的异化",
          "way": "文学哲思",
          "out": "情绪内核"
      },
      {
          "src": "沃霍尔的复制美学",
          "way": "波普化处理",
          "out": "色彩与排列"
      }
  ],
  "transMethod": ["产品语义", "品牌叙事", "情绪转译", "概念转译", "角色化"],
  "presentation": ["IP 形象设定", "表情包与语录", "衍生品", "展板排版"],
  "presCat": "平面/视觉/图像",
  "presNote": "以四款 IP 形象加语录呈现，幽默感靠文案兑现，视觉靠波普化的重复排列。",
  "narration": "理论 — 现象 — 隐喻 — 疗效",
  "narrMethod": "材料—形态—感知",
  "narrBreak": {
      "opening": "直接抛出两个来源：机械复制时代的文化特征 + 年轻人自嘲为「社会边角料」的现象，起点是理论级的。",
      "structure": "立足点（机械复制 + 个体异化）→ 理论资源（卡夫卡 + 沃霍尔）→ 隐喻（职场＝流水线）→ 对象（青年机械化生存困境）→ 手段（四款 IP + 幽默语录）→ 疗效。",
      "rhetoric": "「融汇…与…」的标准理论句式；「诙谐消解」是核心动词——用玩笑而不是控诉来对抗异化。",
      "closing": "落在「重塑个体情绪出口与自我认同，为人们带来治愈与归属感」，把批判收束为治愈。"
  },
  "narrNote": "理论驱动型：开篇就摆出艺术史与文学坐标，是这批作品里学术野心最大的一篇。风险是理论可能盖过形象本身。",
  "desc": "本系列IP形象设计立足于机械复制时代文化特征与个体异化现象，融汇卡夫卡文学哲思与沃霍尔艺术理念，将现代职场隐喻为流水线。“罐头猫才”聚焦青年群体机械化生存困境，以四款IP形象设计结合幽默语录，诙谐消解重复日常、舒缓情绪压力，重塑个体情绪出口与自我认同，为人们带来治愈与归属感。",
  "kw": ["罐头猫才", "异化", "机械复制", "卡夫卡", "沃霍尔", "打工人", "IP", "治愈"],
  "imgs": ["a30_00.jpg", "a30_01.jpg", "a30_02.jpg"]
  },
{
  "id": "a31",
  "year": "2026",
  "title": "瓷渊",
  "sub": "海丝沉船瓷器潮玩设计",
  "authors": "蒋颖、陈一飞",
  "teachers": "丁敏",
  "type": "潮玩 IP · 海丝文创",
  "typeCat": "潮玩/IP/角色",
  "motif": "当代媒介与流行文化",
  "highlight": "古船携瓷沉于深海，五件瓷器化作五只瓷灵——把沉船考古的悲剧性，改写成「静待来日重见天光」的重逢叙事。海丝文化在这里不是知识，是可以收集的角色。",
  "concept": "把海丝沉船瓷器转译成青年向的潮玩 IP，让沉在海底的瓷器以「瓷灵」的身份重见天光。",
  "culture": ["海上丝绸之路", "沉船考古与水下遗存", "外销瓷与东西方交流", "潮玩与集换文化"],
  "cultureNote": "与 a05「瓷旧迎新」（广彩瓷）构成一组对照：同为瓷器题材，瓷旧迎新处理的是纹样与色彩的视觉转译，瓷渊处理的是「命运」——沉船瓷器是被时间封存的物件，「重见天光」这个动作本身就带叙事张力。",
  "symbols": [
      {
          "src": "沉船与深海",
          "way": "叙事场景",
          "out": "世界观起点"
      },
      {
          "src": "五件外销瓷",
          "way": "拟人化为五只瓷灵",
          "out": "潮玩角色"
      },
      {
          "src": "万千瓷盏记忆",
          "way": "角色设定与性格",
          "out": "IP 内容"
      },
      {
          "src": "开放包容的海丝精神",
          "way": "价值观对接当代青年",
          "out": "传播落点"
      }
  ],
  "transMethod": ["品牌叙事", "材料转译", "色彩转译", "行为绑定", "行为转译"],
  "presentation": ["潮玩实物", "角色设定", "展板排版"],
  "presCat": "实物/产品",
  "presNote": "以五只瓷灵成组呈现，配合沉船场景的氛围渲染，强调「重见天光」的叙事感。",
  "narration": "价值重估 — 设定 — 意象",
  "narrMethod": "批判—重构—质询",
  "narrBreak": {
      "opening": "「既是古代商贸遗存，更是东西方文化交流的珍贵见证」——先用一句话给沉船瓷器重新定性。",
      "structure": "价值重估（遗存 → 见证）→ 当代对接（开放包容精神契合青年价值）→ 转译动作（遗产 → 潮玩 IP）→ 叙事设定（古船携瓷沉海、五件化灵、镌刻传奇）→ 意象。",
      "rhetoric": "「化作」「镌刻」「静待」「重见天光」——一组带时间感的动词，把商品做成传说。",
      "closing": "「静待来日重见天光」——用诗性意象收尾，留白。"
  },
  "narrNote": "叙事型 IP 自述：先给文化定性，再给角色设定，最后用一句诗收尾。与 a03「海丝花语」同属海丝母题，可横向对照。",
  "desc": "海上丝绸之路沉船瓷器，既是古代商贸遗存，更是东西方文化交流的珍贵见证，其开放包容的精神契合当代青年价值追求。本设计以沉船瓷器为灵感，将海丝文化遗产转化为青年喜爱的潮玩IP。古船携瓷沉于深海，五件瓷器化作瓷灵，承载万千瓷盏记忆，默默镌刻海丝传奇，静待来日重见天光。",
  "kw": ["瓷渊", "海丝", "沉船", "外销瓷", "瓷灵", "潮玩", "IP", "水下考古"],
  "imgs": ["a31_00.jpg", "a31_01.jpg", "a31_02.jpg", "a31_03.jpg", "a31_04.jpg"]
  },
{
  "id": "a32",
  "year": "2024",
  "title": "随福",
  "sub": "春节户外产品",
  "authors": "邓家明",
  "teachers": "彭圣芳、王柳庄、磨炼、安娃",
  "type": "产品设计 · 节日文化",
  "typeCat": "产品设计",
  "motif": "礼俗/节庆/仪式",
  "highlight": "把春节搬进露营——不是贴春联式的装饰，而是把「幸福吉祥」「对未来的憧憬」这两个春节内核，分别对应到具体的户外行为上，让年味在野外也成立。",
  "concept": "为当代年轻人设计一套春节主题的户外休闲产品，让年味在日常户外生活中延续。",
  "culture": ["春节文化与年俗", "户外露营生活方式", "吉祥符号与祈福行为", "当代青年的节日重构"],
  "cultureNote": "春节文创最大的坑是把「红色 + 福字」贴在任何东西上。作者绕开了这个坑：先拆出春节文化的两个内核（幸福吉祥、对未来的憧憬），再去找它们在户外场景里对应的行为——于是产品不是在「装饰春节」，而是在「执行春节」。",
  "symbols": [
      {
          "src": "幸福吉祥",
          "way": "行为化转译",
          "out": "露营灯、坐垫等产品的语义"
      },
      {
          "src": "对未来的憧憬",
          "way": "行为化转译",
          "out": "飞盘、水壶等产品的使用场景"
      },
      {
          "src": "春节符号与寓意",
          "way": "组合式配件",
          "out": "可拆卸的「年味」"
      },
      {
          "src": "户外五件套（灯、音箱、水壶、坐垫、飞盘）",
          "way": "载体",
          "out": "日常可用性"
      }
  ],
  "transMethod": ["概念转译", "色彩转译", "行为绑定", "行为转译"],
  "presentation": ["产品实物", "场景渲染", "配件组合", "展板排版"],
  "presCat": "实物/产品",
  "presNote": "以套系产品加配件组合呈现，重点证明「有年味但也能日常用」这个双重要求。",
  "narration": "背景 — 载体 — 转译 — 双重目标",
  "narrMethod": "背景—转译—应用",
  "narrBreak": {
      "opening": "「在户外生活方式兴起的背景下」——先给时代背景，再给人群（当代年轻人），切入点很稳。",
      "structure": "背景 → 人群 → 载体（露营灯、音箱、水壶、坐垫、飞盘）→ 转译方法（把春节内涵对应的行为、符号、寓意进行设计）→ 手段（产品与配件组合）→ 双重目标 → 意义。",
      "rhetoric": "「保证…的同时也能…」这个并列句式是全文的核心张力；「更浓的春节氛围」「更好的了解、感受」用递进表达传播意图。",
      "closing": "落在「更好的了解、感受中国春节文化的魅力」，把产品说成文化体验。"
  },
  "narrNote": "稳健的产品设计自述：背景、人群、载体、方法、目标齐全，没有惊艳之处但也没有漏洞。属于「做对了每一步」的类型。",
  "desc": "在户外生活方式兴起的背景下，为当代年轻人设计一套春节主题的户外休闲产品。以露营灯、户外音箱、户外水壶、户外坐垫、飞盘等户外露营产品为载体，将幸福吉祥、对未来的憧憬这两个春节文化内涵中对应的行为、符号、寓意等元素进行设计。通过产品与配件组合的方式，保证产品具有年味氛围的同时也能在日常使用。从而让用户在户外也能感受到更浓的春节氛围，更好的了解、感受中国春节文化的魅力。",
  "kw": ["春节", "随福", "户外", "露营", "年味", "吉祥", "产品", "青年"],
  "imgs": ["a32_00.jpg", "a32_01.jpg", "a32_02.jpg", "a32_03.jpg", "a32_04.jpg"]
  },
{
  "id": "a33",
  "year": "2024",
  "title": "梦鼎",
  "sub": "文物数字叙事",
  "authors": "林梓勋、苏晓钰",
  "teachers": "安娃、王柳庄",
  "type": "数字叙事 · 博物馆体验",
  "typeCat": "影像/内容",
  "motif": "社会议题与群体关怀",
  "highlight": "用 AI 生成文物故事视频，再让用户参与故事创作——把博物馆从「讲解」变成「共同写故事」。核心产出是视频，本页保留链接与封面。",
  "concept": "用 AI 生成结合文物介绍与故事情节的视频，配合实时交互装置，让用户参与文物故事的创作。",
  "culture": ["博物馆展陈的数字化", "AI 生成内容（AIGC）", "文物叙事与故事化传播", "参与式文化"],
  "cultureNote": "博物馆数字化的常见做法是「把说明牌变成屏幕」，作者做的是另一件事：让 AI 生成有情节的故事，再让用户参与创作。关键转变在于——观众从接收者变成共同作者。",
  "symbols": [
      {
          "src": "文物本体",
          "way": "AI 生成故事视频",
          "out": "内容层"
      },
      {
          "src": "故事情节",
          "way": "叙述结构",
          "out": "理解门槛的降低"
      },
      {
          "src": "实时交互装置",
          "way": "用户参与创作",
          "out": "从观看到共创"
      },
      {
          "src": "兴趣激发",
          "way": "教育目标",
          "out": "博物馆公共教育的指标"
      }
  ],
  "transMethod": ["品牌叙事", "形态转译", "情绪转译", "行为绑定", "行为转译"],
  "presentation": ["视频（见上方链接）", "交互装置", "界面", "展板排版"],
  "presCat": "影像/交互/动态",
  "presNote": "核心产出是视频与交互装置，静态图像只能呈现装置与界面；视频链接已放在本页「观看原视频」入口。",
  "narration": "问题 — 手段 — 参与 — 目标",
  "narrMethod": "问题—机制—价值",
  "narrBreak": {
      "opening": "「探索博物展陈在数字化时代的体验创新」——一句话定领域（展陈）、定时代（数字化）、定目标（体验创新）。",
      "structure": "领域 → 手段一（AI 生成结合文物介绍与故事情节的视频）→ 目的（讲述文物背后的故事、帮助理解）→ 手段二（实时交互体验装置）→ 目的（参与创作、激发兴趣）。",
      "rhetoric": "两个「通过…」构成并列结构，清晰地把方案拆成「内容」与「参与」两条线。",
      "closing": "落在「激发观者的兴趣」，博物馆教育的终极指标。"
  },
  "narrNote": "极简的技术型自述：四句话，每句对应一个模块。没有理论铺陈，也没有情绪渲染，是典型的「作品自己会说话」型写法。",
  "desc": "本作品探索博物展陈在数字化时代的体验创新。运用人工智能技术生成结合博物馆文物产品介绍及带有故事情节的视频，讲述文物背后的故事，帮助观者更容易理解文物。通过实时交互体验装置，让用户参与到文物故事创作的过程中，激发观者的兴趣。",
  "kw": ["梦鼎", "博物馆", "AI生成", "数字叙事", "交互装置", "文物", "共创", "视频"],
  "imgs": ["a33_00.jpg", "a33_01.jpg", "a33_02.jpg", "a33_03.jpg", "a33_04.jpg"],
  "video": "https://mp.weixin.qq.com/mp/readtemplate?t=pages/video_player_tmpl&action=mpvideo&auto=0&vid=wxv_3471829309860397060"
  },
{
  "id": "a34",
  "year": "2024",
  "title": "完形",
  "sub": "音形联想",
  "authors": "樊泽渲、王超、刘高伟、陈冰睿",
  "teachers": "张剑",
  "type": "游戏设计 · 汉字教育",
  "typeCat": "游戏/桌游",
  "motif": "当代媒介与流行文化",
  "highlight": "把偏旁部首和拼音首字母绑在一起——读音和字形互相干扰、互相提示，让汉字从「要记的东西」变成「可以联想的游戏」。一张卡片同时训练形与音两个通道。",
  "concept": "通过汉字偏旁部首与拼音首字母的结合，让读音与字形相互影响，激发对汉字的联想与发散。",
  "culture": ["汉字构形学（形声、偏旁部首）", "汉语拼音", "完形心理学（Gestalt）", "识字教育"],
  "cultureNote": "标题「完形」直接指向格式塔心理学——人对不完整图形有自动补全的倾向。作者把这个认知机制用在汉字上：偏旁是形的一半，首字母是音的一半，两者碰撞时大脑会自动「完形」。这是把心理学原理做成游戏机制的干净案例。",
  "symbols": [
      {
          "src": "偏旁部首（形）",
          "way": "卡片要素",
          "out": "视觉通道"
      },
      {
          "src": "拼音首字母（音）",
          "way": "卡片要素",
          "out": "听觉通道"
      },
      {
          "src": "读音 × 字形的相互影响",
          "way": "游戏规则",
          "out": "联想与发散"
      },
      {
          "src": "儿童识字 / 成人回忆",
          "way": "双人群",
          "out": "教育的双重场景"
      }
  ],
  "transMethod": ["概念转译"],
  "presentation": ["游戏卡片", "玩法示意", "展板排版"],
  "presCat": "影像/交互/动态",
  "presNote": "以卡片实物与玩法示意呈现，规则的可理解性比视觉更重要。",
  "narration": "对象 — 机制 — 双向价值",
  "narrMethod": "材料—形态—感知",
  "narrBreak": {
      "opening": "「这是一款关于中国汉字的游戏卡片设计」——第一句就说清楚是什么，毫不含糊。",
      "structure": "对象 → 机制（偏旁部首 × 拼音首字母）→ 效果（读音与字形相互影响、联想与发散）→ 人群（小朋友 + 成年人）→ 双重价值。",
      "rhetoric": "「无论是…还是…都有着不同的…」这个并列句式把两个人群同时纳入；「重新回忆我们『熟知』的汉字」中用引号质疑「熟知」，是全篇最锋利的一处。",
      "closing": "落在「重新回忆我们『熟知』的汉字」，把识字游戏上升到文化反思。"
  },
  "narrNote": "机制说明型：全篇在讲规则怎么跑通，最后一句突然拉高到文化层面，是性价比很高的收尾。",
  "desc": "这是一款关于中国汉字的游戏卡片设计。通过汉字中的偏旁部首与汉语拼音首字母结合的方式，使读音与字形相互影响，吸引使用者对汉字的联想与发散。无论是小朋友还是成年人，都有着不同的游戏教育意义。该产品既可以作为儿童识字阶段的游戏方式，也可以引发成年人在这个数字化的时代中，重新回忆我们“熟知”的汉字。",
  "kw": ["完形", "汉字", "偏旁部首", "拼音", "游戏卡片", "识字", "张剑", "Gestalt"],
  "imgs": ["a34_00.jpg"]
  },
{
  "id": "a35",
  "year": "2024",
  "title": "清悦",
  "sub": "熏香生活产品设计",
  "authors": "杜今",
  "teachers": "王柳庄",
  "type": "生活产品 · 中医养生",
  "typeCat": "产品设计",
  "motif": "女性与身体叙事",
  "highlight": "把「服气」这件事做成产品——中医芳香疗法讲究通过呼吸吸纳药性，作者据此设计节气香方与香器，让养生回到一种随性、平和、常态化的日常状态。",
  "concept": "把中医芳香疗法与节气养生理念结合，设计符合现代轻养生理念的用香方式与香器。",
  "culture": ["中医芳香疗法", "节气养生与治未病", "宋代香事与单足香炉", "当代「轻养生」"],
  "cultureNote": "中医用香的核心是「服气」——通过呼吸让药性进入身体，这与现代香薰追求的「好闻」完全不同。作者抓住了这个差异，把设计重心从气味调配转向「吸入方式」与「节气对应关系」，并参考宋代单足形香炉作为器物原型。",
  "symbols": [
      {
          "src": "芳香类中药的药性",
          "way": "节气香方整合",
          "out": "配方的个性化拼配"
      },
      {
          "src": "二十四节气",
          "way": "时间节律",
          "out": "用香的时机"
      },
      {
          "src": "服气（呼吸吸纳）",
          "way": "香器结构",
          "out": "使用方式"
      },
      {
          "src": "宋代单足形香炉",
          "way": "器物原型",
          "out": "造型依据"
      }
  ],
  "transMethod": ["功能嫁接", "形态转译", "行为转译"],
  "presentation": ["香器实物", "香方系统", "使用场景", "展板排版"],
  "presCat": "实物/产品",
  "presNote": "以香器加香方体系呈现，重点说明「什么时候用什么香」的节气逻辑。",
  "narration": "理念 — 依据 — 整合 — 状态",
  "narrMethod": "材料—形态—感知",
  "narrBreak": {
      "opening": "「用香之道，养生为本；四时香韵，轻养生活」——四字对句开场，先立中医立场。",
      "structure": "理念（养生为本、轻养生活）→ 依据（芳香中药的性质与疗效、服气、鼓舞正气、治未病）→ 转化（养生智慧转为日常行为）→ 整合（节气 + 香方功效、个性化拼配）→ 器物（宋代单足香炉）→ 体验状态。",
      "rhetoric": "文言与白话交织；「随性、平和、常态化」三个形容词连用，定义了「轻养生」的具体状态；「潜移默化的调养」点出非药物的温和路径。",
      "closing": "落在「将健康养生方式轻松融入生活」，与 a12 静髹的「让非遗触手可及」是同一类日常化承诺。"
  },
  "narrNote": "体系型自述：理论依据（中医）、时间框架（节气）、器物原型（宋炉）、使用状态四层齐全，逻辑最完整的一批之一。",
  "desc": "用香之道，养生为本；四时香韵，轻养生活。中医芳香疗法运用芳香类中药的独特性质和疗效，通过服气的方式，鼓舞人体正气，达到治未病和保健目的。本设计将中医养生智慧转化在日常生活行为中；结合中医节气养生理念与香方功效，整合梳理节气香方，通过个性化的香药拼配，并参考宋代单足形香炉，设计符合现代轻养生理念的用香方式与香器。用户可在一种随性、平和、常态化的状态下，通过“嗅香”温和持久的方式，对身心状态起潜移默化的调养功效，将健康养生方式轻松融入生活。",
  "kw": ["清悦", "香道", "中医", "节气", "服气", "养生", "香炉", "宋代"],
  "imgs": ["a35_00.jpg", "a35_01.jpg"]
  },
{
  "id": "a36",
  "year": "2024",
  "title": "沿途的风景",
  "sub": "墙边的慰藉",
  "authors": "孙子雄",
  "teachers": "磨炼、王兆巧",
  "type": "情感化产品 · 氛围灯",
  "typeCat": "产品设计",
  "motif": "记忆/身份/情感",
  "highlight": "把医院里的吊瓶做成氛围灯——「补充能量」这个医疗动作，被翻译成了充电宝功能和一句心理暗喻。第二件更妙：可更换的图案纸片配合灯光投影，让窗外的风景变成可以自己更换的东西。",
  "concept": "两款围绕情感化设计的氛围灯，用光影与可更换的叙事帮助用户舒缓压力、享受片刻宁静。",
  "culture": ["情感化设计", "医疗意象与「补充能量」的隐喻", "第三空间", "光影叙事"],
  "cultureNote": "吊瓶是全中国人都认识的物件，天然携带「虚弱—补充—恢复」的语义链。作者把它转成充电宝 + 氛围灯，是一次相当大胆的情绪挪用：把病房的焦虑感，改写成「给自己充电」的温柔版本。",
  "symbols": [
      {
          "src": "吊瓶",
          "way": "造型挪用",
          "out": "灯体形态"
      },
      {
          "src": "输液 / 补充能量",
          "way": "充电宝功能",
          "out": "功能与隐喻的合谋"
      },
      {
          "src": "可更换的图案纸片",
          "way": "叙事性设计",
          "out": "用户自定义风景"
      },
      {
          "src": "灯光投影",
          "way": "画面呈现",
          "out": "多变的环境氛围"
      }
  ],
  "transMethod": ["产品语义", "功能嫁接", "形态转译", "情绪转译", "概念转译"],
  "presentation": ["灯具实物", "光影效果", "使用场景", "视频", "展板排版"],
  "presCat": "影像/交互/动态",
  "presNote": "两件作品并置：一件靠形态挪用（吊瓶），一件靠可更换叙事（风景投影）。光影变化在视频里呈现得更完整。",
  "narration": "双作品 — 各自机制 — 共同疗效",
  "narrMethod": "材料—形态—感知",
  "narrBreak": {
      "opening": "「两款氛围灯作品均围绕情感化设计作为核心要素」——先给总体定位，再分述两件。",
      "structure": "总体定位（情感化设计）→ 共同目标（有趣视觉、舒缓压力、片刻宁静）→ 作品一（吊瓶灵感、充电宝功能、第三空间）→ 作品二（沿途景观、可换纸片、灯光投影）→ 共同疗效。",
      "rhetoric": "「此设计旨在…」「此设计营造…」两句对称，分别说清两件作品的疗效；「第三空间」这个术语借用得很到位。",
      "closing": "落在「缓解压力，提升工作愉悦度」，把情感价值换算成工作场景的功能价值。"
  },
  "narrNote": "双作品合述型：用「作品一 / 作品二」的编号结构，各自说明机制再汇总结论。结构清晰，但两件之间的关系没有交代。",
  "desc": "两款氛围灯作品均围绕情感化设计作为设计的核心要素，旨在提供有趣的视觉效果、帮助用户舒缓压力，享受片刻宁静。作品一将吊瓶作为设计灵感来源，形成独特的视觉效果，灯体兼具发光充电宝功能，融入“补充能量”元素，此设计旨在为用户创造“第三空间”让人们在忙碌中享受片刻宁静。作品二汲取不一样的沿途景观作为灵感，予以更换的形式，用户可更换图案纸片，形成叙事性设计。再利用灯光投影技术展示不同画面效果。此设计营造多变环境氛围，有助于缓解压力，提升工作愉悦度。",
  "kw": ["氛围灯", "吊瓶", "情感化设计", "充电宝", "第三空间", "光影", "减压", "视频"],
  "imgs": ["a36_00.jpg", "a36_01.jpg", "a36_02.jpg", "a36_03.jpg", "a36_04.jpg", "a36_05.jpg", "a36_06.jpg", "a36_07.jpg", "a36_08.jpg"],
  "video": "https://mp.weixin.qq.com/mp/readtemplate?t=pages/video_player_tmpl&action=mpvideo&auto=0&vid=wxv_3472252056914673665"
  },
{
  "id": "a37",
  "year": "2024",
  "title": "待定",
  "sub": "TO BE RECOGNIZED",
  "authors": "莫依澄、徐梅珠",
  "teachers": "胡好、庄嘉菁",
  "type": "思辨设计 · 可持续设计",
  "typeCat": "思辨/装置",
  "motif": "物/材料/可持续",
  "highlight": "把工业余料和「社会边角料」并置——年轻人自嘲的边角料，与工厂剩下的铝合金余料，共享同一个处境。于是给余料造了一套专属的字符表意系统，让废料自己说话。",
  "concept": "从思辨设计角度，用铝合金工业余料创造一套独特的字符表意系统，质询「有用与无用」的定义。",
  "culture": ["思辨设计（Speculative Design）", "可持续设计与工业余料", "「社会边角料」的自我认知", "符号学与表意系统"],
  "cultureNote": "作品名「待定 TO BE RECOGNIZED」是双关：既指物料的状态待定，也指年轻人等待被社会承认的状态。作者把这两件看似无关的事焊在一起——余料不是「没用的部分」，而是「还没被认出来的部分」。",
  "symbols": [
      {
          "src": "铝合金工业余料",
          "way": "主材",
          "out": "系列产品的物质基底"
      },
      {
          "src": "「社会边角料」（青年自嘲）",
          "way": "概念对位",
          "out": "作品的批判内核"
      },
      {
          "src": "字符表意系统",
          "way": "为余料造一套语言",
          "out": "符号层设计"
      },
      {
          "src": "有用与无用",
          "way": "价值质询",
          "out": "思辨命题"
      }
  ],
  "transMethod": ["品牌叙事", "材料转译", "概念转译"],
  "presentation": ["实物系列", "字符系统", "材料实验", "展板排版"],
  "presCat": "实物/产品",
  "presNote": "以系列实物加字符系统呈现，重点是「余料如何被赋予表意能力」。",
  "narration": "议题 — 对位 — 手段 — 世界观",
  "narrMethod": "媒介—角色—传播",
  "narrBreak": {
      "opening": "第一句就摆出两个议题：可持续领域的工业余料问题 + 年轻人自嘲为「社会边角料」的社会现象。",
      "structure": "双议题 → 立场（从思辨设计角度思考二者的独特价值）→ 材料（铝合金余料为主材）→ 手段（创造独特的字符表意系统）→ 目的（激发对「有用与无用」的思考、展示更开阔包容的世界观）→ 意义。",
      "rhetoric": "「我们希望借此激发…」这种克制的愿望句，是思辨设计的标准语气；「更加开阔和包容的世界观」把材料问题上升为世界观问题。",
      "closing": "落在「为理解当代社会文化现象及可持续设计实践提供新的思路与方向」，学术口径完整。"
  },
  "narrNote": "思辨设计型：不解决问题，只制造一个让人重新思考的处境。与 a17 VITA 同属思辨脉络，但 VITA 虚构未来，本作处理当下材料。",
  "desc": "本作品关注可持续设计领域工业余料问题与当代年轻人自嘲为“社会边角料”的社会现象，从思辨设计的角度思考二者的独特价值与潜在特质。系列产品以铝合金余料为主材，创造一种属于它的独特字符表意系统。我们希望借此激发人们对于可持续理念下“有用与无用”定义的思考，展示一种更加开阔和包容的世界观，为理解当代社会文化现象及可持续设计实践提供新的思路与方向。",
  "kw": ["思辨设计", "余料", "可持续", "社会边角料", "字符系统", "铝合金", "有用与无用"],
  "imgs": ["a37_00.jpg", "a37_01.jpg", "a37_02.jpg", "a37_03.jpg", "a37_04.jpg", "a37_05.jpg"]
  },
{
  "id": "a38",
  "year": "2024",
  "title": "莲脉传情",
  "sub": "",
  "authors": "李佳纯、严一诺、麦艳子、陈婉莹",
  "teachers": "王时音、梁嘉、刘毅",
  "type": "乡村设计 · 公共设施",
  "typeCat": "社会创新/服务",
  "motif": "自然生态与地方景观",
  "highlight": "全村共用的那根蓝色水管，被读成了「人情脉络」——它通向每家每户，大部分埋在地下，只在少数地方露出地表，正如邻里关系本身。于是路灯、健身器材、书报架都由它长出来。",
  "concept": "以莲塘村的「蓝色水管」为符号，在不破坏村貌的前提下，围绕它再设计成一系列乡村公共设施。",
  "culture": ["莲塘村（岭南水乡村落）", "乡村公共设施与基础设施", "邻里关系与人情网络", "乡建与艺术介入"],
  "cultureNote": "这是全部作品里观察力最惊人的一件。作者没有去村子里找「传统符号」（祠堂、古树、镬耳墙），而是盯上了最不起眼的现代基础设施——一根蓝色 PVC 水管。它确实是村子的血管：通向每家每户，大部分不可见。这个发现本身就是设计。",
  "symbols": [
      {
          "src": "蓝色水管",
          "way": "视觉与功能母题",
          "out": "所有设施的形态来源"
      },
      {
          "src": "通向每家每户、大部分藏在地下",
          "way": "人情脉络的隐喻",
          "out": "概念内核"
      },
      {
          "src": "路灯、健身器材、书报架、平板支架",
          "way": "功能再设计",
          "out": "乡村公共设施"
      },
      {
          "src": "不破坏原有村貌",
          "way": "介入边界",
          "out": "设计的克制"
      }
  ],
  "transMethod": ["产品语义", "功能嫁接", "概念转译", "色彩转译", "造型挪用"],
  "presentation": ["设施实物", "村落场景", "改前改后对比", "展板排版"],
  "presCat": "实物/产品",
  "presNote": "以村落实景的「改前 vs 改后」对照呈现，证明设计真的嵌进了原有环境。",
  "narration": "发现 — 隐喻 — 边界 — 多重价值",
  "narrMethod": "批判—重构—质询",
  "narrBreak": {
      "opening": "第一句就是一个具体发现：贯穿全村的公共设施「蓝色水管」是一个有趣的符号。",
      "structure": "发现（蓝色水管）→ 观察（通向每家每户、大部分埋在地下、少数显露）→ 隐喻（象征人情脉络与邻里关系）→ 升格（信息传播符号）→ 边界（不破坏村貌）→ 手段（结合村民与游客需求再设计）→ 成果 → 多重价值。",
      "rhetoric": "「作品有传播、连通之意」——开篇用释义点题；「点亮村落」既是实指（路灯）也是虚指（激活）。",
      "closing": "落在「拉近城乡居民之间的距离」「将艺术融入生活」，乡建设计的标准落点。"
  },
  "narrNote": "观察驱动型：全篇从一个具体物件的发现展开，隐喻是长出来的而不是贴上去的。这类作品最难被复制，因为它依赖作者真的在那个地方待过。",
  "desc": "作品有传播、连通之意，莲塘村的公共设施“蓝色水管”贯穿整个村落，是一个有趣的符号。水管通向每家每户，大部分藏在地下，少数显露出地表，象征着莲塘村的人情脉络与邻里关系。“蓝色水管”成为了乡村对内、对外信息传播的符号，在不破坏莲塘原有村貌的前提下，结合村民和游客的实际需求，对水管进行再设计，如路灯、健身器材、书报架、平板支架等物品，点亮村落并吸引游客。这种设计思路展示乡村生活的丰富与邻里关系，也拉近城乡居民之间的距离，将艺术融入生活，并使外来游客对莲塘村风土人情有更深的体验感。",
  "kw": ["莲塘村", "蓝色水管", "乡村设计", "公共设施", "邻里关系", "乡建", "在地"],
  "imgs": ["a38_00.jpg", "a38_01.jpg", "a38_02.jpg", "a38_03.jpg", "a38_04.jpg", "a38_05.jpg", "a38_06.jpg", "a38_07.jpg"]
  },
{
  "id": "a39",
  "year": "2024",
  "title": "莲谱",
  "sub": "",
  "authors": "肖阳",
  "teachers": "王时音、梁嘉、刘毅",
  "type": "信息设计 · 宗族叙事",
  "typeCat": "视觉/信息",
  "motif": "记忆/身份/情感",
  "highlight": "用电路板的天然肌理还原莲塘景观——族谱不再是纸上的世系表，而是一块「通电」的板子：根茎是血缘，走线是脉络，宗族信息被直接烙印进肌理。",
  "concept": "借用电路板肌理还原莲塘景观，把莲塘村的宗族历史与血缘关系重新编码成一本「族谱」。",
  "culture": ["莲塘村宗族文化", "族谱与血缘记载", "电路板肌理作为信息载体", "时间—空间—血缘的多维叙事"],
  "cultureNote": "与 a38 莲脉传情同属莲塘村课题，两件作品形成绝妙互文：莲脉传情处理「现在的连接」（水管），莲谱处理「时间的连接」（族谱）。而用电路板承载宗族信息，是一次极具张力的材质错配——最冷的工业物，装最热的血缘。",
  "symbols": [
      {
          "src": "莲塘（自然景观）",
          "way": "电路板肌理还原",
          "out": "视觉基底"
      },
      {
          "src": "根茎（血缘象征）",
          "way": "电路走线",
          "out": "个体之间的连接"
      },
      {
          "src": "宗族千年故事",
          "way": "信息烙印",
          "out": "记载方式"
      },
      {
          "src": "电路板",
          "way": "材质错配",
          "out": "传统记载方式的打破"
      }
  ],
  "transMethod": ["形态转译", "材料转译"],
  "presentation": ["装置与印刷品", "肌理细节", "展板排版"],
  "presCat": "空间/装置/展陈",
  "presNote": "以平面化的「谱」呈现，重点在肌理与信息层的关系——远看是莲塘，近看是电路，再看是族谱。",
  "narration": "回望 — 结构 — 手法 — 维度",
  "narrMethod": "背景—转译—应用",
  "narrBreak": {
      "opening": "「回望莲塘村历史，记录宗族千年的故事」——以时间纵深开场，格局很大。",
      "structure": "回望（宗族千年故事）→ 结构（象征血缘的根茎把个体连到一起）→ 产物（一本属于荷塘的族谱）→ 手法（电路板肌理还原景观、宗族信息烙印其中）→ 意义 → 维度。",
      "rhetoric": "「跃然纸上」「烙印其中」——用纸质时代的动词描述电子时代的载体；「从时间、空间、血缘等多维度」是典型的学术收束句式。",
      "closing": "落在「从时间、空间、血缘等多维度展现莲塘宗族的全貌」，三个维度概括全部野心。"
  },
  "narrNote": "信息设计型：全篇在讲「用什么承载信息、如何编码」。与 a38 出自同一课题，建议对照观看。",
  "desc": "回望莲塘村历史，记录宗族千年的故事，由象征血缘的根茎将每位个体联系到一起，组成一本属于荷塘的族谱，关于莲塘村的历史与文化跃然纸上。借用电路板的天然肌理还原莲塘景观，并将宗族信息烙印其中，打破传统的文化信息记载方式，同时保留其当地独特的莲塘意象，从时间、空间、血缘等多维度展现莲塘宗族的全貌。",
  "kw": ["莲谱", "莲塘村", "宗族", "族谱", "电路板", "血缘", "信息设计", "在地"],
  "imgs": ["a39_00.jpg", "a39_01.jpg", "a39_02.jpg", "a39_03.jpg", "a39_04.jpg", "a39_05.jpg", "a39_06.jpg", "a39_07.jpg"]
  },
{
  "id": "a40",
  "year": "2024",
  "title": "节节高灯",
  "sub": "",
  "authors": "卢如诗",
  "teachers": "丁敏、安娃",
  "type": "文创灯具 · 模块化设计",
  "typeCat": "文创/衍生品",
  "motif": "非遗与手工技艺",
  "highlight": "把广彩的形体拆成一个个可移动的小模块——用户可以自己在灯柱上垒叠、搭建，亲手「设计」一盏广彩灯。非遗从被保护的对象变成了可以玩的积木。",
  "concept": "借用模块化设计的「组合式」特点，让用户自行垒叠搭建，设计属于自己的广彩落地灯或台灯。",
  "culture": ["广彩瓷（广州织金彩瓷）", "模块化设计", "非遗技艺的现代化", "用户参与式创造"],
  "cultureNote": "与 a05 瓷旧迎新（广彩纹样餐具）、a31 瓷渊（海丝沉船瓷）构成广彩 / 外销瓷的三重奏。节节高灯的独特之处在于它动的不是纹样，而是「器型」——把完整的广彩器型拆成可组合单元，让结构本身成为用户表达的空间。",
  "symbols": [
      {
          "src": "广彩的色彩体系",
          "way": "模块配色",
          "out": "视觉识别"
      },
      {
          "src": "广彩的典型器型",
          "way": "拆解为独立可移动模块",
          "out": "结构单元"
      },
      {
          "src": "垒叠、搭建",
          "way": "用户操作",
          "out": "参与式设计"
      },
      {
          "src": "「一式一件，弥足珍贵」",
          "way": "唯一性",
          "out": "价值感"
      }
  ],
  "transMethod": ["形态转译", "材料转译", "色彩转译", "行为绑定", "行为转译"],
  "presentation": ["灯具实物", "模块拆解", "组合示意", "展板排版"],
  "presCat": "实物/产品",
  "presNote": "以模块拆解图加多种搭建结果呈现，重点证明「同一套模块能长出不同的灯」。",
  "narration": "研究基础 — 手法 — 用户 — 愿景",
  "narrMethod": "背景—转译—应用",
  "narrBreak": {
      "opening": "「在广彩色彩、器型和图案研究的基础上」——先声明研究基础，再引出手法。",
      "structure": "研究基础 → 手法（借用模块化设计的组合式特点）→ 动作（把广彩形体拆解成独立可移动的小模块）→ 用户行为（自由垒叠、自行设计）→ 成果（落地灯或台灯）→ 愿景。",
      "rhetoric": "「一式一件，弥足珍贵」用收藏品语汇提升价值；「愿以广彩之光温暖我们的生活」中的「光」字双关（灯光与文化的光）。",
      "closing": "「愿以广彩之光温暖我们的生活」——诗意收尾，把产品接回生活。"
  },
  "narrNote": "手法说明型：很短，但把手法的来源（模块化）、动作（拆解）、用户价值（自行设计）都说清楚了。",
  "desc": "本设计在广彩色彩、器型和图案研究的基础上，借用模块化设计中“组合式”这一特点，将广彩的形体拆解成一个个独立的、可移动的小模块，用户可以在灯柱上随意垒叠、搭建，自行“设计”一件广彩落地灯或台灯。一式一件，弥足珍贵，愿以广彩之光温暖我们的生活。",
  "kw": ["广彩", "节节高灯", "模块化", "灯具", "器型", "非遗", "组合", "用户参与"],
  "imgs": ["a40_00.jpg", "a40_01.jpg", "a40_02.jpg", "a40_03.jpg", "a40_04.jpg"]
  },
{
  "id": "a41",
  "year": "2024",
  "title": "金玉满棠",
  "sub": "方寸之间",
  "authors": "陈苑琪、龙雯雅",
  "teachers": "丁敏、安娃",
  "type": "文创产品 · 非遗日常化",
  "typeCat": "文创/衍生品",
  "motif": "非遗与手工技艺",
  "highlight": "不做收藏级的广彩重器，做「方寸之间」的日常小物——把广彩的核心文化价值塞进每天都会用到的东西里，让非遗从展柜走进洗手台和书桌。",
  "concept": "提取广彩的核心文化价值，融入日常生活用品设计，赋予广彩新的生活场景。",
  "culture": ["广彩瓷（国家级非遗）", "非遗的日常化与场景迁移", "传统纹样与当代审美", "文创产品"],
  "cultureNote": "与 a40 节节高灯同属广彩课题、同一组导师。两件作品恰好代表非遗活化的两条路：节节高灯走「结构」（让用户重组器型），金玉满棠走「场景」（让纹样进入日常）。后者更朴素，也更考验「哪些日常物适合承载广彩」的判断力。",
  "symbols": [
      {
          "src": "广彩的核心文化价值",
          "way": "抽象提取",
          "out": "设计依据"
      },
      {
          "src": "传统纹样与色彩",
          "way": "当代化处理",
          "out": "视觉语言"
      },
      {
          "src": "日常用品",
          "way": "载体",
          "out": "新的生活场景"
      },
      {
          "src": "「方寸之间」",
          "way": "尺度限定",
          "out": "小物件的亲密感"
      }
  ],
  "transMethod": ["产品语义", "品牌叙事", "形态转译", "材料转译", "造型挪用"],
  "presentation": ["日用品实物", "纹样细节", "使用场景", "展板排版"],
  "presCat": "实物/产品",
  "presNote": "以系列日常小物呈现，重点展示纹样在不同材质与物件上的适配。",
  "narration": "研究 — 提取 — 融入 — 目的",
  "narrMethod": "背景—转译—应用",
  "narrBreak": {
      "opening": "「通过对非遗广彩的研究与分析」——先声明研究，再给出动作（提取核心文化价值）。",
      "structure": "研究分析 → 提取核心文化价值 → 融入日常生活用品 → 创作系列物品（传统元素 + 趣味性）→ 目的（赋予广彩新的生活场景和发展）。",
      "rhetoric": "全篇只有两句，几乎没有修辞；「传统元素和趣味性」这个并列是唯一的价值判断。",
      "closing": "「以赋予广彩新的生活场景和发展」——把文创的意义说成给非遗找出路。"
  },
  "narrNote": "最朴素的一篇：两句说完，不谈理论也不谈愿景。这类自述在毕设里吃亏，但作品的判断力其实体现在「选了哪些日常物」上。",
  "desc": "通过对非遗广彩的研究与分析，提取其核心文化价值，并将其融入日常生活用品设计中，创作一系列具有广彩传统元素和趣味性的物品，以赋予广彩新的生活场景和发展。",
  "kw": ["广彩", "金玉满棠", "日常用品", "非遗活化", "纹样", "文创", "方寸之间"],
  "imgs": ["a41_00.jpg", "a41_01.jpg", "a41_02.jpg", "a41_03.jpg", "a41_04.jpg"]
  },
{
  "id": "a42",
  "year": "2022",
  "title": "艺术瞎子",
  "authors": "谢宇、雷海林",
  "teachers": "王时音、梁嘉",
  "type": "艺术衍生品 · 观念设计",
  "typeCat": "思辨/装置",
  "motif": "当代媒介与流行文化",
  "highlight": "用『瞎子』做反题——把艺术从『被看见』翻转为『被触摸/被感受』，让非视觉感官也能进入艺术，作品本身是一则关于『如何观看』的设计宣言。",
  "concept": "以『艺术瞎子』为名，质疑以肉眼为中心的单一观看秩序，把艺术欣赏从视觉独占中解放出来，为视障者与非视觉感官另辟一条进入艺术的路径。",
  "culture": ["当代艺术的观看政治", "感官平权与无障碍设计", "艺术衍生品的大众化转向"],
  "cultureNote": "作品借反讽式命名指向艺术场域中长期被遮蔽的『非肉眼观看』群体。它把衍生品的命题从『复制名画』抬升到『重新分配观看权利』，与无障碍设计、感官平权形成对话。",
  "symbols": [
      {
          "src": "『瞎子』这一反题命名",
          "way": "以缺失挑战视觉中心",
          "out": "关于观看权利的议题入口"
      },
      {
          "src": "可触摸/可感受的材质与形态",
          "way": "为盲文与非视觉感官而设计",
          "out": "非视觉的『阅读』通道"
      },
      {
          "src": "被重新『看见』的日常艺术",
          "way": "从殿堂走向身体感知",
          "out": "艺术的大众化与平权"
      }
  ],
  "transMethod": ["概念转译", "产品语义", "视觉转移"],
  "presentation": ["观念装置/衍生品实物", "触觉体验界面", "展陈说明", "观众参与"],
  "presCat": "空间/装置/展陈",
  "presNote": "呈现强调『闭上眼也能看』——以触觉与身体经验替代视觉陈列，让观众被迫切换感官，本身就是作品的一部分。",
  "narration": "反题 — 转译 — 平权",
  "narrMethod": "批判—重构—质询",
  "narrBreak": {
      "opening": "以反讽命名破题，先取消『看』的优先权。",
      "structure": "命名反题 → 感官转译（触觉替代视觉）→ 权利重分配（平权）→ 意义（艺术大众化）。",
      "rhetoric": "用反差词与反问制造张力，弱化形容词、强化立场。",
      "closing": "落到『人人皆可进入艺术』的平权结论。"
  },
  "narrNote": "立场先行型表达：以态度而非造型取胜，概念密度高、物化信息少，属于『以宣言驱动』的衍生品类。",
  "desc": "《艺术瞎子》以反讽式命名质疑以肉眼为中心的单一观看秩序，试图把艺术欣赏从视觉独占中解放出来。作品为非视觉感官与视障群体另辟进入艺术的路径，将艺术从『被看见』翻转为『被触摸、被感受』，把衍生品的命题从复制名画抬升到重新分配观看权利，与无障碍设计和感官平权形成对话，探索艺术在大众生活中更平等的打开方式。",
  "kw": ["艺术瞎子", "观看政治", "感官平权", "无障碍", "艺术衍生品", "触觉", "王时音", "梁嘉"],
  "imgs": ["a42_00.jpg", "a42_01.jpg", "a42_02.jpg"]
