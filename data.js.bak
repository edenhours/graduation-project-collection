  },
  "narrNote": "材料驱动型表达：以材质叙事承载非遗与循环双重主题，物性即论点。",
  "desc": "《酸枝木的圆舞曲——首饰设计》取材广作家具的酸枝木余料，以木材天然的曲面与纹理为设计语言，创作一组将边角废料转化为可佩戴饰品的首饰。作品顺纹随形雕琢，把广作硬木工艺微型化为当代载体，让名贵木材在首饰尺度上重生，既致敬非遗材料，也重新提问『奢侈究竟来自稀缺还是来自巧思』。",
  "kw": ["酸枝木", "广作", "首饰", "红木余料", "非遗再生", "循环设计", "郑颖瑜"],
  "imgs": ["a47_00.jpg", "a47_01.jpg"]
  },
{
  "id": "a48",
  "year": "2022",
  "title": "内 inside",
  "authors": "冯继杰",
  "teachers": "王柳庄、李健",
  "type": "观念家具 · 可持续设计",
  "typeCat": "家具/家居",
  "motif": "物/材料/可持续",
  "highlight": "专门收集广作硬木的『残缺余料』，把缺口、虫眼、开裂当成主角——不补不遮，让不完美自己说话。",
  "concept": "以广作家具边角料中的残缺部分（缺口、虫眼、开裂）为材料，创作观念性家具，主张『不修补的残缺美』，重新讨论余料的尊严。",
  "culture": ["广作硬木余料", "侘寂/残缺美学", "可持续与材料的尊严"],
  "cultureNote": "绝大多数再利用设计都会把残缺『修好』。作者反其道而行，把残缺本身当美学主体，与侘寂哲学相通，也为『余料之外』计划立下一种更诚实的可持续态度。",
  "symbols": [
      {
          "src": "残缺（缺口/虫眼/开裂）",
          "way": "保留并放大为造型语言",
          "out": "残缺美主体"
      },
      {
          "src": "广作硬木",
          "way": "微型家具化",
          "out": "观念的物化"
      },
      {
          "src": "『不修补』的态度",
          "way": "以留白对抗修复",
          "out": "可持续的诚实"
      }
  ],
  "transMethod": ["功能嫁接", "形态转译", "材料转译", "概念转译"],
  "presentation": ["观念家具实物", "残缺特写", "对照图", "展板"],
  "presCat": "实物/产品",
  "presNote": "以特写放大残缺，对照图呈现『修 vs 不修』的立场差异，装置即态度。",
  "narration": "残缺 — 立场 — 尊严",
  "narrMethod": "批判—重构—质询",
  "narrBreak": {
      "opening": "以『不修补』的逆向姿态破题。",
      "structure": "材料选取（残缺）→ 立场声明 → 物化呈现 → 价值讨论。",
      "rhetoric": "用留白与反修复制造哲学感。",
      "closing": "落到『余料也有尊严』。"
  },
  "narrNote": "观念型表达：以态度而非功能取胜，是整组里最『当代艺术』的一件。",
  "desc": "《内 inside》以广作家具边角料中常被丢弃的残缺部分——缺口、虫眼、开裂——为材料，创作观念性家具。作品主张『不修补的残缺美』，刻意保留并放大残缺作为造型语言，与侘寂哲学相通，也为『余料之外』计划立下更诚实的可持续态度，重新讨论余料作为材料的尊严。",
  "kw": ["内inside", "残缺美学", "广作", "余料", "侘寂", "可持续", "冯继杰"],
  "imgs": ["a48_00.jpg", "a48_01.jpg"]
  },
{
  "id": "a49",
  "year": "2022",
  "title": "OMINC艺术家玩具",
  "authors": "张学禹、韩臻元",
