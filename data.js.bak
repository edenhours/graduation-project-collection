          "out": "四位花灵母题"
      },
      {
          "src": "同源植物在东西方的两种命运",
          "way": "「双生」设定，两两成对",
          "out": "八位双生花灵"
      },
      {
          "src": "花语（象征语义）",
          "way": "转为角色性格与配色系统",
          "out": "IP 人格设定"
      },
      {
          "src": "海路与航线",
          "way": "包装与叙事动线",
          "out": "「寻踪而至，花开重逢」的寻访感"
      }
  ],
  "transMethod": ["产品语义", "品牌叙事", "形态转译", "材料转译", "概念转译"],
  "presentation": ["潮玩实物", "角色设定图", "包装与展陈", "展板排版"],
  "presCat": "空间/装置/展陈",
  "presNote": "典型 IP 化呈现：白底产品图确立收藏属性，角色设定图补足人格，成对陈列强化「双生」概念，视觉上先立形象再讲历史。",
  "narration": "背景 — 设定 — 核心句",
  "narrMethod": "背景—转译—应用",
  "narrBreak": {
      "opening": "以宏大历史背景起手（海上丝绸之路花卉传播），迅速把小物件接到大叙事上。",
      "structure": "背景 → 选材（四组花，并给出选择标准：经海路远行、在东西方扎根）→ 设定（八位双生花灵）→ 核心概念句 → 意象收尾。",
      "rhetoric": "全文最短，几乎放弃功能描述，全部押在一句对仗上——「同源异流，隔海相望；寻踪而至，花开重逢」，十六字，对仗、押韵、有画面。",
      "closing": "「让千年花语在掌心重新绽放」——用「千年」对「掌心」，以尺度反差制造诗意。"
  },
  "narrNote": "概念先行型表达：不解释结构、材料与工艺，只用一句概念句加一句诗性收尾完成全部说服。适合 IP 传播，但对评审而言信息量偏薄，属于「以概念取胜、靠展陈补足」的类型。",
  "desc": "本设计以海上丝绸之路花卉传播为背景，选取素馨、水仙、山茶、月季四组经海路远行、在东西方扎根的花卉，塑造八位双生花灵。以“同源异流，隔海相望；寻踪而至，花开重逢”为核心。让千年花语在掌心重新绽放。",
  "kw": ["海上丝绸之路", "潮玩", "花语", "素馨", "水仙", "山茶", "月季", "双生花灵", "IP", "跨文化"],
  "imgs": ["a03_00.jpg", "a03_01.jpg", "a03_02.jpg", "a03_03.jpg", "a03_04.jpg"]
  },
{
  "id": "a04",
  "year": "2026",
  "title": "凳对",
  "authors": "陶炯圭",
  "teachers": "磨炼",
  "type": "产品再设计 · 日常物研究",
  "typeCat": "产品设计",
  "motif": "城市日常与市井文化",
  "highlight": "不去博物馆找符号，而是蹲在街边看人怎么「误用」红胶凳——小桌、脚梯、置物架、玩具台，民间智慧直接被抄成了设计任务书。",
  "concept": "从「广东人实际怎么用红胶凳」出发，把一张省凳从坐具解放为可变形的生活载具。",
  "culture": ["广府市井生活", "红胶凳（「广东省凳」的民间认同）", "物的可供性与民间再创造"],
  "cultureNote": "红胶凳是珠三角最廉价的塑料方凳，却因出现在大排档、婚宴、排队、祭祖等一切场合而成为非官方的「省凳」。作者的文化敏感点在于：不去博物馆找符号，而在地方法看人怎么「误用」物件——这种民间智慧本身就是文化。",
  "symbols": [
      {
          "src": "红胶凳的方正经典造型",
          "way": "作为识别锚点保留原型轮廓",
          "out": "模块化的基本单元"
      },
      {
          "src": "民间非正式用法（小桌、脚梯、置物架、玩具台）",
          "way": "需求清单化，逐条对应",
          "out": "多场景功能模块"
      },
      {
          "src": "可供性 affordance（结构暗示的用法）",
          "way": "模块化接口设计",
          "out": "从坐具到可变载体"
      },
      {
          "src": "「省凳」的身份认同",
          "way": "延续红色与塑料质感",
          "out": "地域识别与情感亲近"
      }
  ],
  "transMethod": ["产品语义", "形态转译", "材料转译", "概念转译", "色彩转译"],
  "presentation": ["实物模型", "使用场景对照", "模块拆解", "展板排版"],
  "presCat": "实物/产品",
  "presNote": "呈现关键在「对照」：先列出民间现场的四种真实用法，再给出对应的模块方案，让再设计看起来是被调研推出来的，而不是拍脑袋。",
  "narration": "观察 — 归纳 — 再设计",
  "narrMethod": "问题—机制—价值",
  "narrBreak": {
      "opening": "「作品以设计回应生活」——一句极短的价值观声明，直接把自己放进「生活派」谱系。",
      "structure": "现象（使用远超坐具范畴）→ 调研证据（小桌、脚梯、置物架、玩具台四个具体用法）→ 概念工具（可供性）→ 策略（保留经典造型 + 模块化）→ 结果（突破坐具局限）→ 升华（可变载体）。",
      "rhetoric": "用枚举制造真实感——四个具体场景并列，比任何形容词都有说服力；引入「可供性」这个专业词，把民间观察上升为设计理论。",
      "closing": "「从坐具到适配生活可变载体的转变」——用一个「从…到…」句式，把功能扩展说成范式转变。"
  },
  "narrNote": "田野观察型表达：最朴素也最扎实。作者把「我调研到了什么」放在最前面，让结论自然生长出来，几乎不作主观抒情，可信度最高。",
  "desc": "作品以设计回应生活。日常红胶凳（广东省省凳）在市井生活中的使用远超坐具范畴。通过观察与调研，广东居民常将其临时用作小桌、脚梯、床头置物架、儿童玩具台等。基于此观察，结合红胶凳可供性特质，以其经典造型为基础，通过模块化作再设计，作品突破仅坐具的功能局限，打造适配多场景下的家居产品，实现从坐具到适配生活可变载体的转变。",
  "kw": ["红胶凳", "广东省凳", "市井", "模块化", "可供性", "再设计", "广府", "日常生活"],
  "imgs": ["a04_00.jpg", "a04_01.jpg", "a04_02.jpg", "a04_03.jpg", "a04_04.jpg", "a04_05.jpg"]
  },
{
  "id": "a05",
  "year": "2025",
  "title": "瓷旧迎新 · C.C.Zoo",
  "sub": "基于广彩瓷动物纹饰的创意餐具设计",
  "authors": "郑葆莹、肖锘瑶",
  "teachers": "丁敏",
  "topic": "格物志 — 博物馆藏品研究与创意设计",
  "type": "文创餐具 · 非遗纹样转译",
  "typeCat": "文创/衍生品",
  "motif": "非遗与手工技艺",
  "highlight": "C 是 China 也是瓷器，于是「瓷器里的动物世界」被直接命名为 C.C.Zoo——一个双关就把广彩瓷的中西混血身世说清楚了。",
  "concept": "把广彩瓷里的动物世界命名为 C.C.Zoo，用现代造型与配色重演锦鸡、蝙蝠、金鱼、鹿、蝴蝶，让非遗纹样从「看」变成「用」。",
  "culture": ["广彩瓷（广州织金彩瓷）", "外销瓷与中西交融史", "传统吉祥动物纹样", "非遗技艺"],
  "cultureNote": "广彩瓷天生就是「来样加工」的混血儿：景德镇白瓷胎运到广州，按欧洲订单绘彩再出口。作者抓住了这个基因，把转译方向从「复古」改成「对话」——不是复原清代广彩，而是延续它当年迎合他者审美的生存策略。",
  "symbols": [
      {
          "src": "锦鸡、蝙蝠、金鱼、鹿、蝴蝶（吉祥动物）",
          "way": "现代造型语言重绘，保留寓意、简化形",
          "out": "五组餐具主体形象"
      },
      {
          "src": "广彩「织金」色彩体系（红金绿高对比）",
          "way": "提高明度、降低金量",
          "out": "年轻化的配色系统"
      },
      {
          "src": "中西交融的外销史",
          "way": "C.C.Zoo 命名与双语感",
          "out": "概念包装与品牌识别"
      },
      {
          "src": "非遗技艺的精致底蕴",
          "way": "保留手绘感与釉面质感",
          "out": "餐具的工艺价值"
      }
  ],
  "transMethod": ["品牌叙事", "形态转译", "材料转译", "概念转译", "色彩转译"],
  "presentation": ["餐具实物", "纹样特写", "展板排版"],
  "presCat": "实物/产品",
  "presNote": "以成套餐具的形式呈现，每组动物对应一类器型；纹样特写补足「解构—重绘」的转译证据。",
  "narration": "概念先行 — 考据 — 平衡",
  "narrMethod": "批判—重构—质询",
  "narrBreak": {
      "opening": "从字母 C 出发做语义递进（China → 瓷器 → 中国），一句就定义出作品的世界观。",
      "structure": "研究基础（馆藏广彩）→ 解构对象（纹样与色彩体系）→ 重绘对象（五种动物意象）→ 灵感（中西交融史）→ 策略（新与旧的平衡）→ 受众（年轻群体）。",
      "rhetoric": "用「既…又…」的平衡句式把矛盾双方都收进来（既延续非遗底蕴，又以轻快语言对话年轻人），是成熟的作品自述策略。",
      "closing": "落在「对话年轻群体」，商业与传播意图明确。"
  },
  "narrNote": "罕见的从「命名」开始的作品——先把概念注册成一个好记的词（C.C.Zoo），再倒推视觉。这种品牌化思维在毕设里很少见。",
  "desc": "C是China的缩写，是瓷器，更代表了中国。C.C.Zoo，瓷器中的动物世界。本系列瓷器设计以博物馆馆藏广彩瓷为研究基础，深入解构传统纹样与色彩体系，以现代设计语言重新诠释锦鸡、蝙蝠、金鱼、鹿、蝴蝶等经典意象。我们以广彩瓷的“中西交融”历史为灵感，在纹样布局、色彩对比与动物形态上探索新与旧的平衡——既延续非遗技艺的精致底蕴，又以轻快活泼的视觉语言对话年轻群体。",
  "kw": ["广彩瓷", "C.C.Zoo", "餐具", "动物纹样", "非遗", "中西交融", "外销瓷", "广州"],
  "imgs": ["a05_00.jpg"]
  },
{
  "id": "a06",
  "year": "2025",
  "title": "远航的种子",
  "sub": "绘本",
  "authors": "肖梦婷",
  "teachers": "丁敏",
  "topic": "格物志 — 博物馆藏品研究与创意设计",
  "type": "绘本 · 跨文化叙事",
  "typeCat": "视觉/信息",
  "motif": "城市日常与市井文化",
  "highlight": "主角不是大班也不是官员，而是少年黄东这个小人物——宏大的文明互鉴被压进一个人的视角，历史瞬间有了体温。",
  "concept": "借《遇见黄东》里的真实人物，用一本绘本重现 18 世纪十三行时期一场东西方的相遇。",
  "culture": ["广州十三行", "18 世纪中西贸易与文化交流", "《遇见黄东》（程美宝）", "微观史学"],
  "cultureNote": "十三行常被写成贸易史或外交史，作者却走「小人物视角」这条微观史学的路径。这一选择让作品避开了宏大叙事的空泛，也让视觉有了具体的承载物。",
  "symbols": [
      {
          "src": "港口、建筑、语言、植物",
          "way": "拼贴并置",
          "out": "文化差异的可视化"
      },
      {
          "src": "广彩瓷纹样、漆器、通草画",
          "way": "本土视觉元素集合",
          "out": "东方一侧的视觉语汇"
      },
      {
          "src": "西方航海图鉴",
          "way": "对照式排版",
          "out": "与东方语汇形成风格对话"
      },
      {
          "src": "碎片化构图",
          "way": "抽象拼贴",
          "out": "历史记忆的斑驳质感"
      }
  ],
  "transMethod": ["形态转译", "造型挪用"],
  "presentation": ["绘本内页", "拼贴插画", "展板排版"],
  "presCat": "视觉/信息",
  "presNote": "以绘本内页连展，靠版面节奏讲故事；拼贴既是视觉手段也是内容本身。",
  "narration": "文献 — 视角 — 手法",
  "narrMethod": "背景—转译—应用",
  "narrBreak": {
      "opening": "直接交代灵感来源（程美宝《遇见黄东》），用真实学术著作背书，起点很高。",
      "structure": "灵感 → 重构对象（十三行时期的具体相遇）→ 符号清单（港口、建筑、语言、植物）→ 视角选择（小人物）→ 主题（中西文明互鉴）→ 视觉手法（抽象拼贴）。",
      "rhetoric": "用「以小…折射…大」的句式一句话压缩方法论。",
      "closing": "以「与西方航海图鉴形成风格对话」收束，把视觉手法上升为文化立场。"
  },
  "narrNote": "学术写作训练痕迹明显：有出处、有方法、有主题，是典型的「研究型创作」自述。",
  "desc": "灵感源自程美宝《遇见黄东》，绘本重构了18世纪广州十三行时期东印度公司大班布莱克与少年黄东的跨文化相遇。通过港口、建筑、语言、植物等多元符号，以小人物的微观视角折射中西文明互鉴的宏大主题。视觉上采用抽象拼贴手法，碎片化的构图呼应历史记忆的斑驳质感，强化文化差异的戏剧性。画面融入广彩瓷器纹样、漆器与通草画等本土元素，与西方航海图鉴形成风格对话。",
  "kw": ["十三行", "绘本", "遇见黄东", "中西交流", "拼贴", "通草画", "小人物视角", "广州"],
  "imgs": ["a06_00.jpg"]
  },
{
  "id": "a07",
  "year": "2025",
  "title": "躺平照明局",
  "sub": "博物馆IP形象设计",
  "authors": "骆铭",
  "teachers": "丁敏",
  "topic": "格物志 — 博物馆藏品研究与创意设计",
  "type": "博物馆 IP · 角色设计",
  "typeCat": "潮玩/IP/角色",
  "motif": "当代媒介与流行文化",
  "highlight": "「他不是王，却曾为王发光——如今，也照亮了现代打工人的内心世界。」一句话把两千年压缩成一个职场梗，顺手完成了博物馆 IP 最难的那步：让文物产生当代情绪共鸣。",
  "concept": "让东汉陶俑座灯穿越到今天，在「躺平照明局」当一名摸鱼的基层打工人。",
  "culture": ["东汉陶俑座灯（1956 年广州东山出土）", "汉代灯具与掌灯制度", "当代「躺平」文化"],
  "cultureNote": "这件作品的聪明在于：它没有把文物「美化」或「萌化」，而是给它安排了一个当代职业身份。胡人俑的形象（来自西域）本就带着「外来务工者」的底色，与今天的打工人天然互文。",
  "symbols": [
      {
          "src": "东汉陶俑座灯（胡人形象、跪坐持灯）",
          "way": "角色设定：来自西域的掌灯小俑",
          "out": "IP 主形象"
      },
      {
          "src": "「掌灯」这一职责",
          "way": "转译为虚构机构「照明局」",
          "out": "世界观与组织架构"
      },
      {
          "src": "当代躺平 / 摸鱼情绪",
          "way": "性格设定：表面尽职、实则放空",
          "out": "表情包与内容矩阵"
      },
      {
          "src": "曾为王发光的历史身份",
          "way": "反差叙事",
          "out": "价值升华句「他不是王，却曾为王发光」"
      }
  ],
  "transMethod": ["品牌叙事", "情绪转译", "材料转译", "色彩转译", "角色化"],
  "presentation": ["IP 形象设定", "表情与场景图", "展板排版"],
  "presCat": "平面/视觉/图像",
  "presNote": "典型 IP 三件套：立绘 + 表情包 + 场景应用。设定先行，视觉服务于人设。",
  "narration": "设定 — 反差 — 共鸣",
  "narrMethod": "人群—意象—体验",
  "narrBreak": {
      "opening": "先给考古学事实（1956 年东山出土、东汉陶俑座灯），建立可信度。",
      "structure": "原型 → 出身设定（西域、王宫掌灯小俑）→ 当代身份（照明局基层打工人）→ 行为反差（表面尽职 vs 实际摸鱼）→ 情感落点（打工人内心世界）。",
      "rhetoric": "全篇用职场语汇重写文物（任职、基层、打工人、摸鱼），制造强烈的时代错置喜感；结尾用转折加对仗完成升华。",
      "closing": "落在「照亮现代打工人的内心世界」，把笑点转成温情。"
  },
  "narrNote": "最会讲故事的写法：先给事实，再给虚构，最后给情绪。一段文字完成「文物—角色—当代共鸣」三级跳，是博物馆 IP 的教科书级自述。",
  "desc": "作品灵感来自1956年广州东山出土的东汉时期的陶俑座灯，是一个融合历史与当代气质的角色IP。他来自西域，原本是王宫中默默掌灯的小俑，如今在“躺平照明局”任职，成了一位基层的照明打工人。表面上尽职尽责地为主人照亮前路，实际上只要一有空隙，便陷入发呆、摸鱼与自我放空的日常。他不是王，却曾为王发光——如今，也照亮了现代打工人的内心世界。",
  "kw": ["躺平照明局", "陶俑座灯", "博物馆IP", "东汉", "广州东山", "打工人", "摸鱼", "文物活化"],
  "imgs": ["a07_00.jpg"]
  },
{
  "id": "a08",
  "year": "2025",
  "title": "清k清k美妆频道",
  "sub": "我在清代教化妆",
  "authors": "卢秋余、张钰莹",
  "teachers": "丁敏",
  "topic": "格物志 — 博物馆藏品研究与创意设计",
  "type": "短视频 · 文创内容设计",
  "typeCat": "影像/内容",
  "motif": "跨文化/海上丝路/外贸",
  "highlight": "外销画仕女变身美妆博主——把博物馆里静止的画像变成会说话、会搞笑的 UP 主，用最当代的媒介语法讲最古老的妆容史。",
  "concept": "让清代外销画里的仕女当美妆博主，用短视频教现代观众化清代妆容。",
  "culture": ["清代广州外销画", "清代女性妆容与审美", "18 世纪欧洲艺术风格", "广府女性簪花习俗（茉莉）"],
  "cultureNote": "外销画本身就是「为西方观众制作的东方图像」，天然带着表演性。作者敏锐地抓住了这点：既然它生来就是给人看的，那就让它继续被看——只是这次是透过手机屏幕。",
  "symbols": [
      {
          "src": "广州外销画仕女图",
          "way": "角色化 + 动态化",
          "out": "美妆博主形象"
      },
      {
          "src": "清代代表性妆容",
          "way": "教程化拆解",
          "out": "短视频内容结构"
      },
      {
