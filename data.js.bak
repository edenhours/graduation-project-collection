{
  "id": "a50",
  "year": "2022",
  "title": "叠器 嵌合",
  "authors": "邓绮璐、陈阳",
  "teachers": "王时音、梁嘉",
  "type": "系统家具 · 参与式设计",
  "typeCat": "家具/家居",
  "motif": "社会议题与群体关怀",
  "highlight": "用『叠』与『嵌合』两个动作把零散构件变成可重组的系统——器物的价值不在单件，而在它们彼此咬合的无限可能。",
  "concept": "围绕『叠』与『嵌合』的构造语言，设计一组可彼此嵌套、堆叠、重组的器物系统，让使用者在拼合中参与完成作品。",
  "culture": ["模块化与系统思维", "东方套叠器物的当代转译", "用户参与的生成式设计"],
  "cultureNote": "作品承接近代『套盒、叠碗』一类东方器物的智慧，但用现代参数化与快接结构重写。它把『完成』交给用户——器物之间的关系比器物本身更重要。",
  "symbols": [
      {
          "src": "叠（垂直堆叠）",
          "way": "尺度递进的几何模块",
          "out": "可生长的器物塔"
      },
      {
          "src": "嵌合（互锁结构）",
          "way": "凹凸卡扣式连接",
          "out": "无需胶接的重组系统"
      },
      {
          "src": "使用者之手",
          "way": "把拼合设为必要环节",
          "out": "参与即创作"
      }
  ],
  "transMethod": ["功能嫁接", "形态转译", "行为绑定", "行为转译"],
  "presentation": ["模块实物", "重组演示图", "结构爆炸图", "展陈"],
  "presCat": "空间/装置/展陈",
  "presNote": "以『拆解—重组』的演示动线呈现，强调系统而非单品；爆炸图把构造语言显性化。",
  "narration": "语言 — 系统 — 参与",
  "narrMethod": "媒介—角色—传播",
  "narrBreak": {
      "opening": "以两个动词『叠/嵌合』立构造语言。",
      "structure": "动作定义 → 模块生成 → 系统搭建 → 用户参与 → 意义（生成式）。",
      "rhetoric": "用动词做标题与主线，逻辑清晰。",
      "closing": "落到『用户参与完成作品』。"
  },
  "narrNote": "结构驱动型表达：说服力来自构造逻辑的严密，而非装饰描述。",
  "desc": "《叠器 嵌合》围绕『叠』与『嵌合』的构造语言，设计一组可彼此嵌套、堆叠、重组的器物系统。作品承接近代东方套叠器物的智慧，以现代参数化与快接结构重写，把『完成』交给使用者——器物之间的咬合关系比单件造型更重要，让用户在拼合中参与并生成属于自己的作品。",
  "kw": ["叠器", "嵌合", "模块化", "东方器物", "参数化", "参与式", "邓绮璐", "陈阳"],
  "imgs": ["a50_00.jpg", "a50_01.jpg", "a50_02.jpg"]
  },
