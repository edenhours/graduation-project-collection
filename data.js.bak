      }
  ],
  "transMethod": ["视觉转移", "角色化", "品牌叙事", "媒介转换"],
  "presentation": ["视频截图", "妆容对照", "产品系列", "展板排版"],
  "presCat": "影像/交互/动态",
  "presNote": "以视频为核心载体，配套妆容图解与实体产品系列，形成「内容 + 产品」的完整链条。",
  "narration": "背景 — 蓝本 — 形式 — 延伸",
  "narrMethod": "媒介—角色—传播",
  "narrBreak": {
      "opening": "「以清代中西文化交融为背景」——用大背景定调，交代时空坐标。",
      "structure": "背景 → 视觉蓝本（外销画仕女图）→ 内容形式（美妆教程视频）→ 角色转换（仕女变博主）→ 风格（搞笑短视频）→ 内容（妆容技巧、审美风尚、文化内涵）→ 产品延伸。",
      "rhetoric": "「化身」是全篇的转译开关；「搞笑」这个词出现在正式作品说明里，说明作者很清楚传播的优先级。",
      "closing": "以茉莉花作为辅助视觉符号收尾，把地域细节当最后一道保险。"
  },
  "narrNote": "传播导向型表达：全篇在讲「谁来讲、讲给谁、用什么形式讲」，而不是「做了什么」。在毕设里是有风险的写法，也最有当代感。",
  "desc": "以清代中西文化交融为背景，广州外销画仕女图为蓝本，制作介绍清代流行妆容的美妆教程视频。外销画中的仕女化身“美妆博主”，以搞笑的短视频互动风格讲解清代流行妆容的技巧与审美风尚，引领观众了解清代女性的几种代表性妆容，及其背后的文化内涵和美学。同步设计清妆产品系列，视觉设计上借鉴了18世纪欧洲艺术风格，融合东方仕女图，传统广府女性簪戴的茉莉花则成为辅助的视觉符号。",
  "kw": ["外销画", "美妆", "短视频", "清代妆容", "仕女图", "茉莉花", "广府", "文创"],
  "imgs": ["a08_00.jpg"]
  },
{
  "id": "a09",
  "year": "2025",
  "title": "点心几件",
  "sub": "广府早茶艺术解压设计",
  "authors": "桂芳怡",
  "teachers": "安娃、磨炼",
  "topic": "广之礼 — 广州城市礼物设计",
  "type": "家居产品 · 文化解压设计",
  "typeCat": "家具/家居",
  "motif": "城市日常与市井文化",
  "highlight": "点心冒的是热气，加湿器冒的也是热气——一次物理现象的巧合被做成了一件产品，早茶的「烟火气」由此变成可闻、可摸、可捏的解压玩具。",
  "concept": "把刚出笼的广式点心做成香薰加湿器，让「一盅两件」的悠闲变成一天里能呼吸好几次的日常。",
  "culture": ["广府早茶（一盅两件）", "广式点心", "广式悠闲的生活哲学"],
  "cultureNote": "早茶在广州不是餐饮而是社交制度与生活方式。作者没有复刻点心造型做文创（最常见的做法），而是抓住「出笼的热气」这个动态瞬间——早茶最有感染力的其实是那个「刚刚好」的时刻。",
  "symbols": [
      {
          "src": "四种代表性早茶点心",
          "way": "造型趣味化",
          "out": "产品外形"
      },
      {
          "src": "出笼的热气",
          "way": "与加湿器雾化同源",
          "out": "功能与意象的合谋"
      },
      {
          "src": "早茶的气味",
          "way": "香薰",
          "out": "嗅觉层面的情绪调节"
      },
      {
          "src": "捏压点心的手感",
          "way": "软胶材质",
          "out": "触觉解压"
      }
  ],
  "transMethod": ["产品语义", "功能嫁接", "形态转译", "情绪转译", "材料转译"],
  "presentation": ["产品实物", "场景渲染", "展板排版"],
  "presCat": "实物/产品",
  "presNote": "四件成组呈现，对应四种点心；场景图放进家居环境，强调「日常化」而非「旅游纪念品化」。",
  "narration": "文化符号 — 功能嫁接 — 体验清单",
  "narrMethod": "人群—意象—体验",
  "narrBreak": {
      "opening": "第一句就给文化定位——「早茶是广州不可替代的文化符号」，先立高度。",
      "structure": "文化定位 → 功能嫁接（早茶 × 香薰加湿器）→ 效果（情感调节、缓解压力、提高生活质量）→ 感官清单（视觉、触觉、嗅觉、趣味造型）→ 转化对象（四种点心）→ 意义。",
      "rhetoric": "用「热气腾腾」这个极具画面感的词把静态器物激活，紧接着罗列四种感官，让体验变得可验证。",
      "closing": "「将广式悠闲融入生活，传递早茶的生活哲学」——从产品升到生活态度。"
  },
  "narrNote": "少有的把「功能嫁接的物理依据」讲清楚的作品：点心冒热气、加湿器也冒气，这不是比喻而是同构。这个巧合是全作最硬的逻辑支点。",
  "desc": "早茶是广州不可替代的文化符号，将出笼的热气腾腾的早茶与家庭香薰加湿器进行结合，实现情感调节和缓解压力，提高生活质量。通过视觉、触觉，嗅觉与趣味造型，将四种代表性的早茶点心转化为有趣丰富的体验。将广式悠闲融入生活，传递早茶的生活哲学。",
  "kw": ["早茶", "点心", "香薰", "加湿器", "解压", "广府", "一盅两件", "生活哲学"],
  "imgs": ["a09_00.jpg"]
  },
{
  "id": "a10",
  "year": "2025",
  "title": "叹茶漫录",
  "sub": "广府早茶文化桌游设计",
  "authors": "黎晓立",
  "teachers": "安娃、磨炼",
  "topic": "广之礼 — 广州城市礼物设计",
  "type": "桌游 · 儿童文化教育",
  "typeCat": "游戏/桌游",
  "motif": "当代媒介与流行文化",
  "highlight": "把「饮茶」这套成人社交仪式降维成儿童能上手的规则——文化科普最难的是让孩子愿意坐下来，桌游恰好解决了入口问题。",
  "concept": "把广府早茶做成给 8-12 岁孩子玩的桌游，让文化认知在游戏机制里自然发生。",
  "culture": ["广府早茶礼仪与食俗", "岭南地域文化", "儿童游戏化学习"],
  "cultureNote": "早茶对儿童而言是「跟着大人去」的被动经验。做成桌游等于把旁观变成参与——孩子不再是跟着喝茶，而是在自己的规则里复演这套文化。",
  "symbols": [
      {
          "src": "早茶点心与茶具",
          "way": "游戏卡牌与棋子",
          "out": "可操作的文化元素"
      },
      {
          "src": "叹茶流程（点单、揭盖、续水、买单）",
          "way": "回合与任务机制",
          "out": "玩法骨架"
      },
      {
          "src": "8-12 岁儿童的认知水平",
          "way": "规则简化",
          "out": "易上手性"
      }
  ],
  "transMethod": ["行为绑定", "行为转译"],
  "presentation": ["桌游实物", "卡牌与版图", "儿童试玩", "展板排版"],
  "presCat": "实物/产品",
  "presNote": "以完整桌游组件呈现（版图、卡牌、棋子），配上儿童试玩场景，证明规则真的跑得通。",
  "narration": "对象 — 需求 — 效果 — 意义",
  "narrMethod": "人群—意象—体验",
  "narrBreak": {
      "opening": "先锚定文化（广府早茶）再锚定人群（8-12 岁儿童），两个坐标一起给。",
      "structure": "文化切入点 → 目标人群与其心理（对广府文化的好奇心）→ 形式（儿童主题桌游）→ 体验（轻松易上手）→ 效果（潜移默化、科普）→ 意义。",
      "rhetoric": "「潜移默化」是教育类设计的核心承诺词，作者用它把「好玩」和「有用」焊在一起。",
      "closing": "「让儿童在游戏中建立对广府文化的认知与兴趣」——认知加兴趣，两个层次都说到。"
  },
  "narrNote": "教育产品设计型表达：人群、场景、效果三段齐全，逻辑朴素但完整。缺点是缺少玩法本身的描述，读完不知道这游戏具体怎么玩。",
  "desc": "作品以广府早茶文化作为切入点，针对8-12岁儿童群体对于广府特色文化的好奇心，制作的一款儿童主题桌游。儿童游玩者在轻松易上手的游戏探索中潜移默化了解早茶及广府地域文化从而达到科普的效果。让儿童在游戏中建立对广府文化的认知与兴趣。",
  "kw": ["早茶", "桌游", "儿童", "科普", "广府文化", "游戏化学习", "8-12岁"],
  "imgs": ["a10_00.jpg"]
  },
{
  "id": "a11",
  "year": "2025",
  "title": "漆华录",
  "sub": "中国大漆色彩系统",
  "authors": "陈美玲",
  "teachers": "庄嘉菁、胡好",
  "topic": "中国大漆文化可持续设计课题",
  "type": "色彩研究 · 文创系统",
  "typeCat": "文创/衍生品",
  "motif": "非遗与手工技艺",
  "highlight": "给大漆做了一套「胶囊色谱」——把矿物颜料封装成现代视觉符号，让八千年的东方颜色第一次有了可编码、可复制、可穿戴的现代接口。",
  "concept": "把大漆的色彩从经验变成数据——用中华五色体系建立可量化、可量产的大漆色谱。",
  "culture": ["中华五色体系（青赤黄白黑）", "五正色与五间色", "大漆工艺", "矿物颜料"],
  "cultureNote": "五色体系不是配色方案，而是一套与方位、五行、礼制绑定的宇宙观。作者的处理很聪明：不谈玄学，只谈「色粉—大漆」的可量化实验，把文化系统转译成色彩科学问题，避开了非遗文创常有的空泛。",
  "symbols": [
      {
          "src": "五正色、五间色",
          "way": "色粉-大漆实验",
          "out": "编码模型与色彩数据库"
      },
      {
          "src": "矿物颜料",
          "way": "「胶囊色谱」封装",
          "out": "现代视觉符号"
      },
      {
          "src": "大漆色谱",
          "way": "首饰载体",
          "out": "「色彩可穿戴」"
      }
  ],
  "transMethod": ["品牌叙事", "情绪转译", "材料转译", "色彩转译"],
  "presentation": ["色谱图", "实验样片", "首饰实物", "展板排版"],
  "presCat": "实物/产品",
  "presNote": "研究过程（实验样片、色谱图）加成果（首饰产品）两段式呈现，先证明体系的科学性，再证明它的可用性。",
  "narration": "体系 — 实验 — 转化 — 应用",
  "narrMethod": "材料—形态—感知",
  "narrBreak": {
      "opening": "直接给出研究切入点（中华五色体系），第一句就把作品放进学术坐标。",
      "structure": "切入点 → 方法（文献考据 + 色彩科学）→ 目标（大漆色谱系统）→ 实验 → 创新封装（胶囊色谱）→ 转化 → 产品（可量产文创）→ 载体（漆色谱首饰）→ 概念。",
      "rhetoric": "通篇名词堆叠（文献考据、色彩科学、编码模型、色彩数据库、可量产），高密度术语构成专业感，几乎不用形容词。",
      "closing": "「建立兼具东方美学与现代价值的工艺体系」——用「体系」收尾，宣告这不是一件作品而是一套方法。"
  },
  "narrNote": "典型的研究型自述：全程讲方法与产出，情绪含量为零。可信度最高，传播性最弱，但在评审席上最安全。",
  "desc": "本设计以中华五色体系为大漆色彩研究切入点，融合文献考据与色彩科学，构建大漆色谱系统。通过色粉-大漆实验建立五正色、五间色编码模型，形成可量化色彩数据库。创新\"胶囊色谱\"封装设计，转化矿物颜料为现代视觉符号，开发可量产文创产品。以漆色谱首饰为载体，通过\"色彩可穿戴\"概念活化传统色彩，建立兼具东方美学与现代价值的工艺体系。",
  "kw": ["大漆", "五色体系", "色谱", "胶囊色谱", "矿物颜料", "首饰", "色彩可穿戴", "非遗", "量化"],
  "imgs": ["a11_00.jpg"]
  },
{
  "id": "a12",
  "year": "2025",
  "title": "静髹",
  "sub": "大漆木胎素髹文化体验产品",
  "authors": "杨仕璋",
  "teachers": "庄嘉菁、胡好",
  "topic": "中国大漆文化可持续设计课题",
  "type": "体验产品 · 非遗工艺普及",
  "typeCat": "产品设计",
  "motif": "非遗与手工技艺",
  "highlight": "不做漆器做「髹漆」——把成品换成过程，让人亲手经历漆液从调和到固化的那几天，非遗从观看对象变成了身体记忆。",
  "concept": "把需要专业场地的大漆髹涂工序，压缩成一套在家就能完成的沉浸式工具包。",
  "culture": ["大漆工艺（八千年东方美学）", "宋代素髹美学", "漆木共生", "过程美学"],
  "cultureNote": "大漆的门槛不只是技术，还有时间和场地（需要荫房、需要数日固化）。作者选「宋代素髹」作为美学内核很关键——素髹不施纹样，只呈现漆本身的质感与色泽，恰好是「最少技法、最多体感」的入口。",
  "symbols": [
      {
          "src": "繁复的大漆工序（髹涂、推光…）",
          "way": "模块化工具包",
          "out": "核心步骤化"
      },
      {
          "src": "荫房等专业场地",
          "way": "居家环境适配",
          "out": "突破场地限制"
      },
      {
          "src": "宋代素髹的极简美学",
          "way": "保留素色、去除装饰",
          "out": "降低技法门槛"
      },
      {
          "src": "漆液从调和到固化",
          "way": "时间体验",
          "out": "过程美学"
      }
  ],
  "transMethod": ["形态转译", "材料转译", "色彩转译"],
  "presentation": ["工具包实物", "步骤图解", "使用过程", "展板排版"],
  "presCat": "实物/产品",
  "presNote": "以工具包加步骤图呈现，重点展示「人如何操作」而非成品长什么样——这在毕设展上是很勇敢的选择。",
  "narration": "困境 — 方案 — 体验 — 意义",
  "narrMethod": "问题—机制—价值",
  "narrBreak": {
      "opening": "先指出非遗传播的真实困境（受限于专业场地与繁复工序），是批判式开篇。",
      "structure": "困境 → 创新方案（居家沉浸式髹漆方案）→ 美学内核（宋代素髹）→ 手段（模块化工具包）→ 突破（居家环境）→ 体验（亲身感受调和到固化）→ 意义。",
      "rhetoric": "「沉浸式」「触手可及」「过程美学」三个词构成价值三角；「极简流程」与「繁复工序」形成前后对照。",
      "closing": "「让非遗技艺触手可及」——口号式收尾，简洁有力。"
  },
  "narrNote": "问题驱动加体验导向：全篇在讲「为什么以前做不到」和「现在怎么做到」，方案感很强。",
  "desc": "大漆工艺作为承裁八千年东方美学的活态遗产，其传播仍受限于专业场地与繁复工序。本套装创新设计“居家沉浸式髹漆方案”，以宋代素髮美学为内核，通过模块化工具包将传统工序简化为髹涂、推光等核心步骤，突破居家环境限制，使用者可亲身感受漆液从调和到固化的技艺，于极简流程中体会漆木共生的传統智慧，彰显过程美学，让非遗技艺触手可及。",
  "kw": ["大漆", "素髹", "体验产品", "工具包", "宋代美学", "非遗", "过程美学", "居家"],
  "imgs": ["a12_00.jpg"]
  },
{
  "id": "a13",
  "year": "2025",
  "title": "云点",
  "sub": "智能点茶机设计",
  "authors": "何洪健",
  "teachers": "王柳庄、李健、彭圣芳",
  "topic": "Hello！中国茶 — 茶文化研究与创新设计",
  "type": "智能产品 · 传统文化现代化",
  "typeCat": "产品设计",
  "motif": "饮食文化",
  "highlight": "把「茶百戏」——那门在茶沫上作画的宋代绝技——变成可自定义的办公社交内容，一千年前的炫技成了今天的朋友圈素材。",
  "concept": "用一台智能点茶机，把宋代点茶与茶百戏搬进现代办公室。",
  "culture": ["宋代点茶法", "茶百戏（分茶、茶画）", "宋代文人茶事", "现代办公文化"],
  "cultureNote": "点茶是被明代泡茶法取代的「失落的饮茶方式」，茶百戏更是近乎失传。作者没有做博物馆式复原，而是把它当成「可被机器执行的流程」——因为点茶本质上是一套高度标准化的动作（碾、罗、调膏、注汤、击拂），天然适合自动化。",
  "symbols": [
      {
          "src": "点茶的标准化动作序列",
          "way": "机器执行",
          "out": "智能点茶机"
      },
      {
